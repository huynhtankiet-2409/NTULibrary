@model ProjectCK_65131559.Models.TacGia

@{
    ViewBag.Title = "Xóa Tác Giả";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-xl mx-auto space-y-6">
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold text-red-600 flex items-center">
            <i class="fas fa-exclamation-triangle mr-3"></i>
            Xác Nhận Xóa Tác Giả
        </h2>
        <p class="text-gray-600 mt-2">Bạn có chắc chắn muốn xóa tác giả này? Hành động này không thể hoàn tác.</p>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8">
        <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">Thông tin tác giả:</h3>
            <div class="bg-gray-50 p-4 rounded-lg">
                <p class="mb-2"><strong>Họ Tên:</strong> @Model.HoTen</p>
                <p><strong>Giới thiệu:</strong> @(string.IsNullOrEmpty(Model.GioiThieu) ? "Chưa có thông tin" : Model.GioiThieu)</p>
            </div>
            
            @if (Model.TaiLieux != null && Model.TaiLieux.Any())
            {
                <div class="mt-4 p-3 bg-yellow-50 border-l-4 border-yellow-400 text-yellow-700 text-sm">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Cảnh báo:</strong> Tác giả này đang được gán cho <strong>@Model.TaiLieux.Count</strong> tài liệu. Nếu xóa, liên kết sẽ bị gỡ bỏ.
                </div>
            }
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="flex items-center justify-between">
                <a href="@Url.Action("Index")" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Hủy bỏ
                </a>
                <button type="submit" class="px-8 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition-colors shadow-md">
                    <i class="fas fa-trash-alt mr-2"></i>Xác nhận xóa
                </button>
            </div>
        }
    </div>
</div>
