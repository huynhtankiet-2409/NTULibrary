@{
    var controller = ViewContext.RouteData.Values["controller"].ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin - NTU E-Library</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'sidebar-blue': '#1e40af',
                        'sidebar-dark': '#1e3a8a',
                        'admin-red': '#dc2626',
                        'admin-light': '#ef4444',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-gradient-to-b from-sidebar-blue to-sidebar-dark text-white flex-shrink-0 overflow-y-auto">
            <!-- Logo/Header -->
            <div class="p-4 border-b border-white/20">
                <div class="flex items-center space-x-3">
                    <img src="~/Images/logo.jpg" alt="NTU Logo" class="h-12 w-12 rounded-full object-cover shadow-md">
                    <div>
                        <h1 class="font-bold text-lg">NTU E-LIBRARY</h1>
                        <p class="text-xs text-blue-200">MSSV: 65131559</p>
                    </div>
                </div>
            </div>

            <!-- Navigation Menu -->
            <nav class="p-4 space-y-1">
                <!-- Tổng quan -->

                <a href="@Url.Action("Index", "AdminHome_65131559", new { area = "Admin_65131559" })" 
                   class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-chart-line w-5"></i>
                    <span>Tổng quan</span>
                </a>

                <!-- QUẢN LÝ TÀI LIỆU Section -->
                <div class="pt-4 pb-2">
                    <p class="text-xs font-semibold text-blue-200 px-3 uppercase tracking-wider">Quản lý tài liệu</p>
                </div>
                
                <a href="@Url.Action("Index", "TaiLieu_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-file-alt w-5"></i>
                    <span>Tài liệu số</span>
                </a>
                
                <a href="@Url.Action("Index", "DanhMucCha_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-folder w-5"></i>
                    <span>Danh mục</span>
                </a>

                <a href="@Url.Action("Index", "DanhMucCon_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-sitemap w-5"></i>
                    <span>Danh mục con</span>
                </a>

                <a href="@Url.Action("Index", "NhaXuatBan_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-building w-5"></i>
                    <span>Nhà xuất bản</span>
                </a>
                
                <a href="@Url.Action("Index", "TacGia_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-user-edit w-5"></i>
                    <span>Quản lý tác giả</span>
                </a>

                <!-- TƯƠNG TÁC & PHẢN HỒI Section -->
                <div class="pt-4 pb-2">
                    <p class="text-xs font-semibold text-blue-200 px-3 uppercase tracking-wider">Tương tác & Phản hồi</p>
                </div>

                <a href="@Url.Action("Index", "DanhGia_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-comments w-5"></i>
                    <span>Đánh giá & Bình luận</span>
                </a>

                <a href="@Url.Action("Index", "YeuCau_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200 @(controller == "YeuCau_65131559" ? "bg-white/20 text-white" : "")">
                    <i class="fas fa-clipboard-list w-5"></i>
                    <span>Yêu cầu & Hỗ trợ</span>
                </a>

                <!-- QUẢN LÝ DIỄN ĐÀN Section -->
                <div class="pt-4 pb-2">
                    <p class="text-xs font-semibold text-blue-200 px-3 uppercase tracking-wider">Quản lý diễn đàn</p>
                </div>
                
                <a href="@Url.Action("Index", "DienDanChuyenMuc_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200 @(controller == "DienDanChuyenMuc_65131559" ? "bg-white/20 text-white" : "")">
                    <i class="fas fa-folder-tree w-5"></i>
                    <span>Cấu trúc diễn đàn</span>
                </a>
                
                <a href="@Url.Action("Index", "DienDanBaiViet_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200 @(controller == "DienDanBaiViet_65131559" ? "bg-white/20 text-white" : "")">
                    <i class="fas fa-shield-halved w-5"></i>
                    <span>Kiểm duyệt bài viết</span>
                </a>
                
                <a href="@Url.Action("Index", "DienDanBaoCao_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200 @(controller == "DienDanBaoCao_65131559" ? "bg-white/20 text-white" : "")">
                    <i class="fas fa-flag w-5"></i>
                    <span>Báo cáo vi phạm</span>
                </a>

                <!-- HỆ THỐNG & NGƯỜI DÙNG Section -->
                <div class="pt-4 pb-2">
                    <p class="text-xs font-semibold text-blue-200 px-3 uppercase tracking-wider">Hệ thống & người dùng</p>
                </div>
                
                <a href="@Url.Action("Index", "NguoiDung_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-users w-5"></i>
                    <span>Quản lý Người dùng</span>
                </a>
                
                <a href="@Url.Action("Dashboard", "LichSuTruyCap_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-history w-5"></i>
                    <span>Lịch sử truy cập</span>
                </a>
                
                <a href="@Url.Action("Index", "TaiLieuYeuThich_65131559", new { area = "Admin_65131559" })" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-white/10 hover:text-white transition-colors duration-200">
                    <i class="fas fa-heart w-5"></i>
                    <span>Danh sách Yêu thích</span>
                </a>
            </nav>

            <!-- Logout Button -->
            <div class="p-4 mt-auto">
                <a href="@Url.Action("Logout", "Account_65131559", new { area = "" })" 
                   class="flex items-center justify-center space-x-2 bg-red-600 hover:bg-red-700 text-white px-4 py-3 rounded-lg transition-colors duration-200 font-medium shadow-lg">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Top Header -->
            <header class="bg-white shadow-sm border-b border-gray-200 px-6 py-4">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-3">
                            <div class="text-right">
                                <p class="text-sm font-semibold text-gray-800">Admin 65131559</p>
                                <p class="text-xs text-gray-500">@User.Identity.Name</p>
                            </div>
                            <div class="w-10 h-10 rounded-full bg-orange-500 flex items-center justify-center text-white font-bold">
                                A
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Content -->
            <main class="flex-1 overflow-y-auto p-6">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="bg-white border-t border-gray-200 px-6 py-4 sticky bottom-0 z-10">
                <p class="text-center text-sm text-gray-600">
                    © @DateTime.Now.Year - Dự án 65131559 - NTU E-Library
                </p>
            </footer>
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
