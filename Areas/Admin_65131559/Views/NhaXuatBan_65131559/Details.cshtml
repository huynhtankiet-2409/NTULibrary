@model ProjectCK_65131559.Models.NhaXuatBan

@{
    ViewBag.Title = "Chi tiết Nhà xuất bản";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-3xl mx-auto mt-6">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="flex items-center justify-between p-6 border-b border-gray-100 bg-gray-50">
            <h2 class="text-xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-building text-blue-600 mr-3"></i>Chi tiết Nhà xuất bản
            </h2>
            <div class="px-3 py-1 bg-gray-200 text-gray-700 rounded text-sm font-mono">
                ID: @Model.MaNXB
            </div>
        </div>

        <div class="p-8 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-1">
                    <span class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Tên Nhà xuất bản</span>
                    <div class="p-3 bg-gray-50 rounded border border-gray-200 text-gray-900 font-medium text-lg">
                        @Model.TenNXB
                    </div>
                </div>

                <div class="space-y-1">
                    <span class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Địa chỉ</span>
                    <div class="p-3 bg-gray-50 rounded border border-gray-200 text-gray-900">
                        @(Model.DiaChi ?? "Chưa cập nhật")
                    </div>
                </div>
            </div>

            <div class="pt-6">
                <h3 class="text-sm font-bold text-gray-900 mb-4 border-b pb-2">Tài liệu của Nhà xuất bản này:</h3>
                @if (Model.TaiLieux != null && Model.TaiLieux.Any())
                {
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
                            @foreach (var tl in Model.TaiLieux.Take(5))
                            {
                                <li>
                                    <a href="@Url.Action("Details", "TaiLieu_65131559", new { id = tl.MaTaiLieu })" class="text-blue-600 hover:text-blue-800 hover:underline">
                                        @tl.TenTaiLieu
                                    </a>
                                </li>
                            }
                        </ul>
                        @if (Model.TaiLieux.Count > 5)
                        {
                            <div class="mt-2 text-xs text-gray-500 italic">... và @(Model.TaiLieux.Count - 5) tài liệu khác.</div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500 italic">Chưa có tài liệu nào.</p>
                }
            </div>
        </div>

        <div class="bg-gray-50 px-6 py-4 flex justify-between items-center border-t border-gray-100">
            <a href="@Url.Action("Index")" class="text-gray-600 hover:text-gray-900 font-medium">
                <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
            </a>
            <div class="flex space-x-3">
                <a href="@Url.Action("Edit", new { id = Model.MaNXB })" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-sm font-medium transition-colors">
                    <i class="fas fa-edit mr-1"></i>Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>
