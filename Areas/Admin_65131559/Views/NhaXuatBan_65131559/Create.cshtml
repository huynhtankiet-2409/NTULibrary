@model ProjectCK_65131559.Models.NhaXuatBan

@{
    ViewBag.Title = "Thêm Nhà xuất bản";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-blue-50">
            <h2 class="text-xl font-bold text-gray-800">
                <i class="fas fa-plus-circle text-blue-600 mr-2"></i>Thêm Nhà xuất bản
            </h2>
            <a href="@Url.Action("Index")" class="text-sm text-gray-500 hover:text-gray-700">
                <i class="fas fa-times mr-1"></i>Hủy
            </a>
        </div>
        
        <div class="p-6">
            @using (Html.BeginForm()) 
            {
                @Html.AntiForgeryToken()
                
                <div class="space-y-6">
                    @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm font-medium bg-red-50 p-3 rounded" })

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tên Nhà xuất bản <span class="text-red-500">*</span></label>
                        @Html.EditorFor(model => model.TenNXB, new { htmlAttributes = new { @class = "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-11", placeholder = "Nhập tên nhà xuất bản..." } })
                        @Html.ValidationMessageFor(model => model.TenNXB, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Địa chỉ</label>
                        @Html.EditorFor(model => model.DiaChi, new { htmlAttributes = new { @class = "block w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm h-11", placeholder = "Nhập địa chỉ nhà xuất bản..." } })
                        @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <div class="flex items-center justify-end pt-4 border-t mt-6 space-x-3">
                        <a href="@Url.Action("Index")" class="px-5 py-2.5 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 transition-colors">
                            Quay lại
                        </a>
                        <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg shadow-sm transition-colors flex items-center">
                            <i class="fas fa-save mr-2"></i>Lưu thông tin
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
