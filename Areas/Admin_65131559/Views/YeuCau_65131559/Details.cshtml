@model ProjectCK_65131559.Models.YeuCau

@{
    ViewBag.Title = "Chi tiết Yêu cầu #" + Model.MaYeuCau;
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="@Url.Action("Index")" class="hover:text-sidebar-blue">Quản lý yêu cầu</a>
        <i class="fas fa-chevron-right mx-2 text-xs self-center"></i>
        <span class="text-gray-800 font-medium">Chi tiết yêu cầu #@Model.MaYeuCau</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Request Content -->
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-100 flex justify-between items-center">
                    <h4 class="font-bold text-gray-800 flex items-center">
                        <i class="fas fa-info-circle text-sidebar-blue mr-3"></i> Thông tin yêu cầu
                    </h4>
                    <span class="text-xs text-gray-400 italic">Mã: #@Model.MaYeuCau</span>
                </div>
                <div class="p-6 space-y-4">
                    <div>
                        <h5 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Tiêu đề</h5>
                        <p class="text-lg font-bold text-gray-900 leading-tight">@Model.TieuDe</p>
                    </div>
                    
                    <div>
                        <h5 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-1">Nội dung chi tiết</h5>
                        <div class="bg-blue-50/50 p-4 rounded-xl border border-blue-100/50 text-gray-700 leading-relaxed">
                            @Model.NoiDung
                        </div>
                    </div>
                </div>
            </div>

            <!-- Response Form -->
            <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
                <div class="bg-sidebar-blue px-6 py-4 flex justify-between items-center">
                    <h4 class="font-bold text-white flex items-center">
                        <i class="fas fa-reply-all mr-3"></i> Phản hồi từ Admin
                    </h4>
                </div>
                <div class="p-6">
                    @using (Html.BeginForm("Handle", "YeuCau_65131559", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.MaYeuCau)
                        
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">Trạng thái xử lý</label>
                                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                                    <label class="relative flex items-center p-3 rounded-lg border border-gray-100 cursor-pointer hover:bg-gray-50 transition-all has-[:checked]:bg-amber-50 has-[:checked]:border-amber-200">
                                        <input type="radio" name="TrangThai" value="ChoXuLy" class="text-amber-500 focus:ring-amber-500 mr-2" @(Model.TrangThai == "ChoXuLy" ? "checked" : "")>
                                        <span class="text-xs font-bold text-amber-700">Chờ xử lý</span>
                                    </label>
                                    <label class="relative flex items-center p-3 rounded-lg border border-gray-100 cursor-pointer hover:bg-gray-50 transition-all has-[:checked]:bg-blue-50 has-[:checked]:border-blue-200">
                                        <input type="radio" name="TrangThai" value="DangXuLy" class="text-blue-500 focus:ring-blue-500 mr-2" @(Model.TrangThai == "DangXuLy" ? "checked" : "")>
                                        <span class="text-xs font-bold text-blue-700">Đang xử lý</span>
                                    </label>
                                    <label class="relative flex items-center p-3 rounded-lg border border-gray-100 cursor-pointer hover:bg-gray-50 transition-all has-[:checked]:bg-green-50 has-[:checked]:border-green-200">
                                        <input type="radio" name="TrangThai" value="DaXong" class="text-green-500 focus:ring-green-500 mr-2" @(Model.TrangThai == "DaXong" ? "checked" : "")>
                                        <span class="text-xs font-bold text-green-700">Đã xong</span>
                                    </label>
                                    <label class="relative flex items-center p-3 rounded-lg border border-gray-100 cursor-pointer hover:bg-gray-50 transition-all has-[:checked]:bg-red-50 has-[:checked]:border-red-200">
                                        <input type="radio" name="TrangThai" value="TuChoi" class="text-red-500 focus:ring-red-500 mr-2" @(Model.TrangThai == "TuChoi" ? "checked" : "")>
                                        <span class="text-xs font-bold text-red-700">Từ chối</span>
                                    </label>
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">Nội dung phản hồi</label>
                                <textarea name="PhanHoiTuAdmin" rows="5" class="w-full rounded-xl border-gray-200 focus:ring-sidebar-blue focus:border-sidebar-blue text-sm" placeholder="Nhập câu trả lời hoặc kết quả giải quyết cho người dùng...">@Model.PhanHoiTuAdmin</textarea>
                            </div>

                            <div class="flex items-center justify-between pt-4">
                                <a href="@Url.Action("Index")" class="text-gray-500 hover:text-gray-700 font-medium text-sm flex items-center">
                                    <i class="fas fa-arrow-left mr-2"></i> Quay lại
                                </a>
                                <button type="submit" class="bg-sidebar-blue text-white px-8 py-2.5 rounded-xl font-bold hover:bg-sidebar-dark transition-all shadow-lg hover:shadow-xl flex items-center">
                                    <i class="fas fa-save mr-2"></i> Cập nhật phản hồi
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
            <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
                <h4 class="font-bold text-gray-800 mb-4 text-xs uppercase tracking-widest flex items-center border-b border-gray-50 pb-2">
                    <i class="fas fa-user-circle mr-2 text-sidebar-blue"></i> Người yêu cầu
                </h4>
                <div class="flex items-center space-x-4 mb-4">
                    <div class="w-12 h-12 rounded-full bg-sidebar-blue/10 flex items-center justify-center text-sidebar-blue font-bold text-lg">
                         @(Model.NguoiDung != null && !string.IsNullOrEmpty(Model.NguoiDung.HoTen) ? Model.NguoiDung.HoTen.Substring(0, 1).ToUpper() : "?")
                    </div>
                    <div>
                        <p class="font-bold text-gray-900">@(Model.NguoiDung != null ? Model.NguoiDung.HoTen : "Không xác định")</p>
                        <p class="text-xs text-gray-500">MSSV: @(Model.NguoiDung != null ? Model.NguoiDung.TenDangNhap : "N/A")</p>
                    </div>
                </div>
                <div class="space-y-2 text-sm">
                    <p class="flex justify-between">
                        <span class="text-gray-400">Email:</span>
                        <span class="text-gray-700 font-medium">@(Model.NguoiDung != null ? Model.NguoiDung.Email : "N/A")</span>
                    </p>
                    <p class="flex justify-between">
                        <span class="text-gray-400">Vai trò:</span>
                        <span class="text-gray-700 font-medium capitalize">@(Model.NguoiDung != null ? Model.NguoiDung.VaiTro : "N/A")</span>
                    </p>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
                <h4 class="font-bold text-gray-800 mb-4 text-xs uppercase tracking-widest flex items-center border-b border-gray-50 pb-2">
                    <i class="fas fa-clock mr-2 text-sidebar-blue"></i> Mốc thời gian
                </h4>
                <div class="space-y-4">
                    <div class="relative pl-6 before:content-[''] before:absolute before:left-1 before:top-2 before:bottom-0 before:w-0.5 before:bg-gray-100 last:before:hidden">
                        <div class="absolute left-0 top-1.5 w-2 h-2 rounded-full bg-blue-500 ring-4 ring-blue-50"></div>
                        <p class="text-xs text-gray-400">Gửi lúc</p>
                        <p class="text-sm font-bold text-gray-700">@(Model.NgayGui.HasValue ? Model.NgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</p>
                    </div>
                    
                    @if (Model.NgayXuLy.HasValue)
                    {
                        <div class="relative pl-6">
                            <div class="absolute left-0 top-1.5 w-2 h-2 rounded-full bg-green-500 ring-4 ring-green-50"></div>
                            <p class="text-xs text-gray-400">Xử lý gần nhất</p>
                            <p class="text-sm font-bold text-gray-700">@Model.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }
                    else
                    {
                         <div class="relative pl-6">
                            <div class="absolute left-0 top-1.5 w-2 h-2 rounded-full bg-gray-300 ring-4 ring-gray-50"></div>
                            <p class="text-xs text-gray-400 italic">Chưa xử lý</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
