@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.YeuCau>

@{
    ViewBag.Title = "Quản lý Yêu cầu & Hỗ trợ";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-6">
    <!-- Header area -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h3 class="text-2xl font-bold text-gray-800">Quản lý Yêu cầu & Hỗ trợ</h3>
            <p class="text-sm text-gray-500">Tiếp nhận và xử lý các kiến nghị, yêu cầu từ sinh viên và cán bộ.</p>
        </div>
        
        <div class="flex items-center space-x-2">
            <form method="get" action="@Url.Action("Index")" class="flex items-center space-x-2">
                <select name="trangThai" onchange="this.form.submit()" class="rounded-lg border-gray-300 text-sm focus:ring-sidebar-blue focus:border-sidebar-blue">
                    <option value="">Tất cả trạng thái</option>
                    <option value="ChoXuLy" @(ViewBag.CurrentTrangThai == "ChoXuLy" ? "selected" : "")>Chờ xử lý</option>
                    <option value="DangXuLy" @(ViewBag.CurrentTrangThai == "DangXuLy" ? "selected" : "")>Đang xử lý</option>
                    <option value="DaXong" @(ViewBag.CurrentTrangThai == "DaXong" ? "selected" : "")>Đã xong</option>
                    <option value="TuChoi" @(ViewBag.CurrentTrangThai == "TuChoi" ? "selected" : "")>Từ chối</option>
                </select>
                <a href="@Url.Action("Index")" class="p-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200" title="Làm mới">
                    <i class="fas fa-sync-alt"></i>
                </a>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 rounded shadow-sm flex items-center">
            <i class="fas fa-check-circle mr-2"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Requests Table -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 text-gray-600 uppercase text-xs font-bold">
                    <tr>
                        <th class="px-6 py-4">Mã</th>
                        <th class="px-6 py-4">Người gửi</th>
                        <th class="px-6 py-4">Tiêu đề</th>
                        <th class="px-6 py-4">Ngày gửi</th>
                        <th class="px-6 py-4 text-center">Trạng thái</th>
                        <th class="px-6 py-4 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        var statusClass = "bg-gray-100 text-gray-700";
                        var statusText = item.TrangThai;
                        
                        switch(item.TrangThai)
                        {
                            case "ChoXuLy":
                                statusClass = "bg-amber-100 text-amber-700";
                                statusText = "Chờ xử lý";
                                break;
                            case "DangXuLy":
                                statusClass = "bg-blue-100 text-blue-700";
                                statusText = "Đang xử lý";
                                break;
                            case "DaXong":
                                statusClass = "bg-green-100 text-green-700";
                                statusText = "Đã xong";
                                break;
                            case "TuChoi":
                                statusClass = "bg-red-100 text-red-700";
                                statusText = "Từ chối";
                                break;
                        }

                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4 font-medium text-gray-900">#@item.MaYeuCau</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 mr-3 text-xs font-bold">
                                        @(item.NguoiDung != null && !string.IsNullOrEmpty(item.NguoiDung.HoTen) ? item.NguoiDung.HoTen.Substring(0, 1).ToUpper() : "?")
                                    </div>
                                    <div class="text-sm">
                                        <p class="font-bold text-gray-800">@(item.NguoiDung != null ? item.NguoiDung.HoTen : "N/A")</p>
                                        <p class="text-xs text-gray-500">@(item.NguoiDung != null ? item.NguoiDung.TenDangNhap : "")</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm font-medium text-gray-800 line-clamp-1">@item.TieuDe</p>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">
                                @(item.NgayGui.HasValue ? item.NgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="px-2.5 py-1 rounded-full text-xs font-bold @statusClass">
                                    @statusText
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="@Url.Action("Details", new { id = item.MaYeuCau })" class="inline-flex items-center px-3 py-1.5 bg-sidebar-blue text-white rounded-lg hover:bg-sidebar-dark transition-all text-xs font-bold shadow-sm">
                                    <i class="fas fa-edit mr-1.5"></i> Xử lý
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-400 italic">
                                <i class="fas fa-inbox text-4xl mb-3 block opacity-20"></i>
                                Không tìm thấy yêu cầu nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
        
        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                        </p>
                    </div>
                    <div>
                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                            @if (Model.HasPreviousPage)
                            {
                                <a href="@Url.Action("Index", new { page = Model.PageIndex - 1, trangThai = ViewBag.CurrentTrangThai })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                    <span class="sr-only">Previous</span>
                                    <i class="fas fa-chevron-left h-5 w-5"></i>
                                </a>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.PageIndex)
                                {
                                    <span class="relative z-10 inline-flex items-center bg-sidebar-blue px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sidebar-blue">@i</span>
                                }
                                else
                                {
                                    <a href="@Url.Action("Index", new { page = i, trangThai = ViewBag.CurrentTrangThai })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                                }
                            }

                            @if (Model.HasNextPage)
                            {
                                <a href="@Url.Action("Index", new { page = Model.PageIndex + 1, trangThai = ViewBag.CurrentTrangThai })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                    <span class="sr-only">Next</span>
                                    <i class="fas fa-chevron-right h-5 w-5"></i>
                                </a>
                            }
                        </nav>
                    </div>
                </div>
            </div>
        }
    }
</div>
