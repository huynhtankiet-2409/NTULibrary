@model ProjectCK_65131559.Models.TaiLieu

@{
    ViewBag.Title = "Chỉnh Sửa Tài Liệu";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-start">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <i class="fas fa-edit text-ntu-blue mr-3"></i>
                    Chỉnh Sửa Tài Liệu
                </h2>
                <p class="text-gray-600 mt-2">@Model.TenTaiLieu</p>
            </div>
            <a href="@Url.Action("ManageAuthors", new { id = Model.MaTaiLieu })" class="bg-purple-600 text-white px-5 py-2 rounded-lg hover:bg-purple-700 transition-colors duration-200 flex items-center shadow-md">
                <i class="fas fa-user-friends mr-2"></i>
                Quản lý tác giả
                @if (Model.TacGias != null && Model.TacGias.Any())
                {
                    <span class="ml-2 bg-white text-purple-600 rounded-full px-2 py-0.5 text-xs font-bold">@Model.TacGias.Count()</span>
                }
            </a>
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-8">
        @using (Html.BeginForm("Edit", "TaiLieu_65131559", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "bg-red-50 border-l-4 border-red-500 p-4 mb-6 text-red-700" })
            @Html.HiddenFor(model => model.MaTaiLieu)
            @Html.HiddenFor(model => model.NgayTao)
            @Html.HiddenFor(model => model.LuotXem)
            @Html.HiddenFor(model => model.LuotTai)

            <!-- Section 1: Thông tin cơ bản -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b-2 border-blue-500">
                    <i class="fas fa-info-circle text-blue-500 mr-2"></i>
                    Thông tin cơ bản
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Tên tài liệu -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-heading mr-1"></i> Tên tài liệu <span class="text-red-500">*</span>
                        </label>
                        @Html.TextBoxFor(model => model.TenTaiLieu, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                        @Html.ValidationMessageFor(model => model.TenTaiLieu, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- ISBN -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-barcode mr-1"></i> ISBN
                        </label>
                        @Html.TextBoxFor(model => model.ISBN, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                        @Html.ValidationMessageFor(model => model.ISBN, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Năm xuất bản -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-calendar-alt mr-1"></i> Năm xuất bản
                        </label>
                        @Html.TextBoxFor(model => model.NamXuatBan, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", type = "number" })
                        @Html.ValidationMessageFor(model => model.NamXuatBan, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Danh mục -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-folder mr-1"></i> Danh mục
                        </label>
                        @Html.DropDownListFor(model => model.MaDanhMucCon, (SelectList)ViewBag.MaDanhMucConList, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                        @Html.ValidationMessageFor(model => model.MaDanhMucCon, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Nhà xuất bản -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-building mr-1"></i> Nhà xuất bản
                        </label>
                        @Html.DropDownListFor(model => model.MaNXB, (SelectList)ViewBag.MaNXBList, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                        @Html.ValidationMessageFor(model => model.MaNXB, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>
                </div>
            </div>

            <!-- Section 2: Thông tin File -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b-2 border-green-500">
                    <i class="fas fa-file mr-2 text-green-500"></i>
                    Thông tin File
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Đường dẫn file -->
                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-link mr-1"></i> Đường dẫn file
                        </label>
                        @Html.TextBoxFor(model => model.DuongDanFile, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", @readonly = "readonly" })
                        @Html.ValidationMessageFor(model => model.DuongDanFile, "", new { @class = "text-red-500 text-sm mt-1" })
                        
                        <!-- Upload Document -->
                        <div class="mt-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">
                                <i class="fas fa-file-upload mr-1"></i> Upload file tài liệu mới
                            </label>
                            <input type="file" name="docFile" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                            <p class="text-xs text-gray-500 mt-1">Hỗ trợ: PDF, Word, Excel, PowerPoint. Nếu upload, đường dẫn trên sẽ tự động cập nhật.</p>
                        </div>
                    </div>

                    <!-- Định dạng -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-file-alt mr-1"></i> Định dạng file
                        </label>
                        @Html.DropDownListFor(model => model.DinhDang,
                            new SelectList(new[] { "PDF", "DOCX", "DOC", "XLSX", "XLS", "PPTX", "PPT", "MP3", "WAV", "MP4", "AVI", "MKV", "ZIP", "RAR" }),
                            "-- Chọn định dạng --",
                            new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                        @Html.ValidationMessageFor(model => model.DinhDang, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Dung lượng -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-database mr-1"></i> Dung lượng (MB)
                        </label>
                        @Html.TextBoxFor(model => model.DungLuongMB, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(model => model.DungLuongMB, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>

                    <!-- Quyền tải xuống -->
                    <div class="md:col-span-2">
                        <label class="flex items-center space-x-3 cursor-pointer">
                            <input type="checkbox" name="ChoPhepTai" value="true" @(Model.ChoPhepTai == true ? "checked" : "") class="w-5 h-5 text-blue-600 rounded focus:ring-blue-500" />
                            <span class="text-sm font-semibold text-gray-700">
                                <i class="fas fa-download text-green-500 mr-2"></i>
                                Cho phép người dùng tải xuống tài liệu
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Section 3: Metadata -->
            <div class="mb-8">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b-2 border-purple-500">
                    <i class="fas fa-image mr-2 text-purple-500"></i>
                    Metadata & Mô tả
                </h3>
                <div class="space-y-6">
                    <!-- URL Ảnh bìa -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-link mr-1"></i> Đường dẫn Ảnh bìa (hoặc upload bên dưới)
                        </label>
                        @Html.TextBoxFor(model => model.AnhBia, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                        @Html.ValidationMessageFor(model => model.AnhBia, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>
                    
                    <!-- Upload Ảnh bìa -->
                     <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-upload mr-1"></i> Tải ảnh bìa mới
                        </label>
                        <input type="file" name="imageFile" accept="image/*" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                        <p class="text-xs text-gray-500 mt-1">Chọn ảnh mới để thay thế ảnh hiện tại. Để trống nếu muốn giữ nguyên.</p>
                    </div>

                    <!-- Mô tả -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-align-left mr-1"></i> Mô tả tóm tắt
                        </label>
                        @Html.TextAreaFor(model => model.MoTa, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", rows = "4", maxlength = "500" })
                        @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-red-500 text-sm mt-1" })
                    </div>
                </div>
            </div>

            <!-- Readonly info -->
            <div class="mb-6 bg-gray-50 rounded-lg p-4">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                    <div>
                        <span class="text-gray-600">Ngày tạo:</span>
                        <span class="font-medium text-gray-900 ml-2">
                            @(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                        </span>
                    </div>
                    <div>
                        <span class="text-gray-600">Lượt xem:</span>
                        <span class="font-medium text-gray-900 ml-2">@(Model.LuotXem ?? 0)</span>
                    </div>
                    <div>
                        <span class="text-gray-600">Lượt tải:</span>
                        <span class="font-medium text-gray-900 ml-2">@(Model.LuotTai ?? 0)</span>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-between pt-6 border-t">
                <a href="@Url.Action("Index")" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Quay lại
                </a>
                <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md">
                    <i class="fas fa-save mr-2"></i>Lưu thay đổi
                </button>
            </div>
        }
    </div>
</div>

<style>
    .ntu-blue {
        color: #667eea;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
