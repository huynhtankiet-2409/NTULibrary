@model ProjectCK_65131559.Models.TaiLieu

@{
    ViewBag.Title = "Chi tiết tài liệu";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-5xl mx-auto space-y-6">
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-6 pb-4 border-b">
            <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-info-circle text-blue-600 mr-3"></i>
                Chi tiết tài liệu
            </h2>
            <div class="text-sm text-gray-500">
                Mã tài liệu: <span class="font-mono font-semibold">@Model.MaTaiLieu</span>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column: Image -->
            <div class="lg:col-span-1">
                <div class="bg-gray-50 p-4 rounded-lg border border-gray-100 flex flex-col items-center">
                    @if (!string.IsNullOrEmpty(Model.AnhBia))
                    {
                        <img src="@Model.AnhBia" alt="Bìa sách" class="w-48 h-auto object-cover rounded-md shadow-md mb-4" />
                    }
                    else
                    {
                        <div class="w-48 h-64 bg-gradient-to-br from-blue-100 to-indigo-200 rounded-md flex items-center justify-center shadow-md mb-4 text-gray-400">
                            <i class="fas fa-book text-6xl opacity-50"></i>
                        </div>
                    }
                    
                    <div class="text-center w-full mt-2">
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold
                            @(Model.ChoPhepTai == true ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                            <i class="fas @(Model.ChoPhepTai == true ? "fa-download" : "fa-lock") mr-1"></i>
                            @(Model.ChoPhepTai == true ? "Cho phép tải" : "Không cho phép tải")
                        </span>
                    </div>

                    <div class="flex justify-around w-full mt-6 text-sm text-gray-600">
                        <div class="text-center">
                            <div class="text-lg font-bold text-gray-900">@Model.LuotXem</div>
                            <div>Lượt xem</div>
                        </div>
                        <div class="text-center">
                            <div class="text-lg font-bold text-gray-900">@Model.LuotTai</div>
                            <div>Lượt tải</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Details -->
            <div class="lg:col-span-2 space-y-6">
                <div>
                    <h3 class="text-xl font-bold text-gray-900 leading-tight">@Model.TenTaiLieu</h3>
                    @if (!string.IsNullOrEmpty(Model.ISBN))
                    {
                        <p class="text-sm text-gray-500 mt-1">ISBN: <span class="font-mono">@Model.ISBN</span></p>
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 mt-1 italic">Chưa cập nhật ISBN</p>
                    }
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4 gap-x-8 text-sm">
                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Danh mục</span>
                        <div class="mt-1 font-medium text-gray-900 flex items-center">
                            <i class="fas fa-folder text-yellow-500 mr-2 opacity-75"></i>
                            @(Model.DanhMucCon != null ? Model.DanhMucCon.TenDanhMucCon : "Chưa phân loại")
                        </div>
                    </div>
                    
                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Tác giả</span>
                        <div class="mt-1 font-medium text-gray-900">
                            @if (Model.TacGias != null && Model.TacGias.Any())
                            {
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var tg in Model.TacGias)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            @tg.HoTen
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-gray-400 italic">Chưa có tác giả</span>
                            }
                        </div>
                    </div>

                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Nhà xuất bản</span>
                        <div class="mt-1 font-medium text-gray-900">
                            @(Model.NhaXuatBan != null ? Model.NhaXuatBan.TenNXB : "Chưa cập nhật")
                        </div>
                    </div>

                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Năm xuất bản</span>
                        <div class="mt-1 font-medium text-gray-900">@(Model.NamXuatBan != null ? Model.NamXuatBan.ToString() : "---")</div>
                    </div>
                    
                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Định dạng</span>
                        <div class="mt-1">
                            <span class="px-2 py-0.5 rounded text-xs font-bold bg-gray-200 text-gray-700">
                                @(Model.DinhDang != null ? Model.DinhDang.ToUpper() : "FILE")
                            </span>
                        </div>
                    </div>

                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Dung lượng</span>
                        <div class="mt-1 font-medium text-gray-900">@(Model.DungLuongMB != null ? Model.DungLuongMB.Value.ToString("0.00") : "0") MB</div>
                    </div>
                    
                    <div>
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold">Ngày tạo</span>
                        <div class="mt-1 font-medium text-gray-900">@(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "")</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DuongDanFile))
                    {
                    <div class="md:col-span-2">
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold mb-1">Đường dẫn file</span>
                        <div class="flex items-center bg-gray-50 p-2 rounded border border-gray-200">
                            <i class="fas fa-file-alt text-gray-400 mr-2"></i>
                            <span class="text-xs font-mono text-gray-600 truncate flex-1">@Model.DuongDanFile</span>
                        </div>
                    </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.MoTa))
                {
                    <div class="pt-4 border-t border-gray-100">
                        <span class="block text-gray-500 text-xs uppercase tracking-wider font-semibold mb-2">Mô tả</span>
                        <div class="text-gray-700 text-sm leading-relaxed whitespace-pre-line bg-gray-50 p-4 rounded-lg border border-gray-100">
                            @Model.MoTa
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 pt-6 border-t flex flex-wrap gap-4 justify-end">
             <a href="@Url.Action("Index")" class="px-5 py-2.5 border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 hover:text-gray-900 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-gray-200">
                <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
            </a>
            
            <a href="@Url.Action("ManageAuthors", new { id = Model.MaTaiLieu })" class="px-5 py-2.5 bg-indigo-50 border border-indigo-200 rounded-lg text-indigo-700 font-medium hover:bg-indigo-100 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-indigo-200">
                <i class="fas fa-user-friends mr-2"></i>Quản lý tác giả
            </a>

            <a href="@Url.Action("Edit", new { id = Model.MaTaiLieu })" class="px-5 py-2.5 bg-blue-600 rounded-lg text-white font-medium hover:bg-blue-700 shadow-sm transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                <i class="fas fa-edit mr-2"></i>Chỉnh sửa
            </a>
        </div>
    </div>
</div>
