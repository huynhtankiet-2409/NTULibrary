@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.TaiLieu>

@{
    ViewBag.Title = "Quản lý Tài Liệu";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-6">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-lg shadow-sm">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                <p class="text-green-700 font-medium">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <i class="fas fa-book text-ntu-blue mr-3"></i>
                    Quản lý Tài Liệu
                </h2>
                <p class="text-gray-600 mt-1">Quản lý sách, tài liệu, file multimedia</p>
            </div>
            <a href="@Url.Action("Create")" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors duration-200 flex items-center shadow-md">
                <i class="fas fa-plus-circle mr-2"></i>
                Thêm tài liệu mới
            </a>
        </div>
    </div>

    <!-- Documents Table -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gradient-to-r from-blue-600 to-indigo-600">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Tài liệu</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Danh mục</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Tác giả</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-white uppercase tracking-wider whitespace-nowrap">Thông tin File</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Thống kê</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-white uppercase tracking-wider">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class= "hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4">
                                <div class="flex items-start">
                                    @if (!string.IsNullOrEmpty(item.AnhBia))
                                    {
                                        <img class="h-16 w-12 object-cover rounded shadow-sm mr-3" src="@item.AnhBia" alt="Cover">
                                    }
                                    else
                                    {
                                        <div class="h-16 w-12 bg-gradient-to-br from-blue-100 to-indigo-100 rounded flex items-center justify-center mr-3">
                                            <i class="fas fa-book text-blue-400 text-2xl"></i>
                                        </div>
                                    }
                                    <div class="flex-1">
                                        <div class="text-sm font-semibold text-gray-900">@item.TenTaiLieu</div>
                                        @if (!string.IsNullOrEmpty(item.ISBN))
                                        {
                                            <div class="text-xs text-gray-500 mt-1">ISBN: @item.ISBN</div>
                                        }
                                        @if (item.NamXuatBan.HasValue)
                                        {
                                            <div class="text-xs text-gray-500">Năm: @item.NamXuatBan</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-sm text-gray-900">@(item.DanhMucCon != null ? item.DanhMucCon.TenDanhMucCon : "N/A")</span>
                                @if (item.NhaXuatBan != null)
                                {
                                    <div class="text-xs text-gray-500 mt-1">@item.NhaXuatBan.TenNXB</div>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (item.TacGias != null && item.TacGias.Any())
                                {
                                    var authors = item.TacGias.ToList();
                                    var displayAuthors = authors.Take(2);
                                    <div class="space-y-1">
                                        @foreach (var author in displayAuthors)
                                        {
                                            <div class="text-xs text-gray-700">
                                                <i class="fas fa-user-edit text-gray-400 mr-1"></i>
                                                @author.HoTen
                                            </div>
                                        }
                                        @if (authors.Count > 2)
                                        {
                                            <div class="text-xs text-blue-600 font-medium">+@(authors.Count - 2) tác giả khác</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400 italic">Chưa có tác giả</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex flex-col space-y-2 items-center justify-center">
                                    <div class="flex items-center space-x-2 justify-center">
                                        @if (!string.IsNullOrEmpty(item.DinhDang))
                                        {
                                            var format = item.DinhDang.ToUpper();
                                            var badgeClass = "";
                                            var icon = "";
                                            
                                            switch (format)
                                            {
                                                case "PDF": badgeClass = "bg-red-100 text-red-800"; icon = "fa-file-pdf"; break;
                                                case "DOCX": case "DOC": badgeClass = "bg-blue-100 text-blue-800"; icon = "fa-file-word"; break;
                                                case "XLSX": case "XLS": badgeClass = "bg-green-100 text-green-800"; icon = "fa-file-excel"; break;
                                                case "PPTX": case "PPT": badgeClass = "bg-orange-100 text-orange-800"; icon = "fa-file-powerpoint"; break;
                                                default: badgeClass = "bg-gray-100 text-gray-800"; icon = "fa-file"; break;
                                            }
                                            
                                            <span class="px-2 py-1 text-xs font-semibold rounded @badgeClass whitespace-nowrap">
                                                <i class="fas @icon mr-1"></i>@format
                                            </span>
                                        }
                                    </div>
                                    
                                    @if (item.DungLuongMB.HasValue)
                                    {
                                        <div class="text-xs text-gray-500">
                                            <i class="fas fa-database text-gray-400 mr-1"></i>
                                            @item.DungLuongMB.Value.ToString("0.##") MB
                                        </div>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col space-y-2 items-start">
                                    @if (item.ChoPhepTai == true)
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold rounded bg-green-100 text-green-800 whitespace-nowrap">
                                            <i class="fas fa-check-circle mr-1"></i>Được tải
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold rounded bg-yellow-100 text-yellow-800 whitespace-nowrap">
                                            <i class="fas fa-eye mr-1"></i>Chỉ xem
                                        </span>
                                    }
                                    <div class="text-xs text-gray-600">
                                        <i class="fas fa-eye text-blue-500 mr-1"></i>
                                        @(item.LuotXem ?? 0) lượt xem
                                    </div>
                                    <div class="text-xs text-gray-600">
                                        <i class="fas fa-download text-green-500 mr-1"></i>
                                        @(item.LuotTai ?? 0) lượt tải
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="flex justify-center items-center space-x-2">
                                    <a href="@Url.Action("Edit", new { id = item.MaTaiLieu })" 
                                       class="text-blue-600 hover:text-blue-800 transition-colors" 
                                       title="Chỉnh sửa">
                                        <i class="fas fa-edit text-lg"></i>
                                    </a>
                                    <a href="@Url.Action("ManageAuthors", new { id = item.MaTaiLieu })" 
                                       class="text-purple-600 hover:text-purple-800 transition-colors" 
                                       title="Quản lý tác giả">
                                        <i class="fas fa-user-friends text-lg"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.MaTaiLieu })" 
                                       class="text-indigo-600 hover:text-indigo-800 transition-colors" 
                                       title="Chi tiết">
                                        <i class="fas fa-info-circle text-lg"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.MaTaiLieu })" 
                                       class="text-red-600 hover:text-red-800 transition-colors" 
                                       title="Xóa">
                                        <i class="fas fa-trash text-lg"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-book-open text-6xl text-gray-300 mb-4"></i>
                <p class="text-gray-500 text-lg">Chưa có tài liệu nào trong hệ thống</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex - 1 })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left h-5 w-5"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative z-10 inline-flex items-center bg-blue-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex + 1 })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .ntu-blue {
        background-color: #667eea;
    }
    .ntu-dark {
        background-color: #5568d3;
    }
</style>
