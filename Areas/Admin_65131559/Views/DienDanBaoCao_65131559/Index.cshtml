@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.DienDan_BaoCao>

@{
    ViewBag.Title = "Quản lý Báo cáo vi phạm";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-flag text-red-600 mr-3"></i>
            Danh sách Báo cáo Vi phạm
        </h2>
        <p class="text-gray-600 mt-1">Xử lý các báo cáo về nội dung xấu hoặc spam từ sinh viên</p>
    </div>

    <!-- Reports List -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 text-gray-500 text-xs font-semibold uppercase">
                    <tr>
                        <th class="px-6 py-4 text-left">Bài viết bị báo cáo</th>
                        <th class="px-6 py-4 text-left">Người báo cáo / Ngày</th>
                        <th class="px-6 py-4 text-left">Lý do vi phạm</th>
                        <th class="px-6 py-4 text-center">Trạng thái xử lý</th>
                        <th class="px-6 py-4 text-center">Quyết định</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="text-sm font-bold text-gray-900 line-clamp-1">@item.DienDan_BaiViet.TieuDe</div>
                                <div class="text-xs text-gray-500 italic">Trạng thái bài: @item.DienDan_BaiViet.TrangThai</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@item.NguoiDung.HoTen</div>
                                <div class="text-xs text-gray-400">@(item.NgayBaoCao.HasValue ? item.NgayBaoCao.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="bg-red-50 text-red-700 text-xs px-3 py-2 rounded-lg border border-red-100 max-w-xs line-clamp-2">
                                    @item.LyDo
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (string.IsNullOrEmpty(item.TrangThaiXuLy))
                                {
                                    <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800 animate-pulse">Chưa xử lý</span>
                                }
                                else
                                {
                                    <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800">@item.TrangThaiXuLy</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (string.IsNullOrEmpty(item.TrangThaiXuLy))
                                {
                                    <div class="flex justify-center space-x-2">
                                        @using (Html.BeginForm("Handle", "DienDanBaoCao_65131559", FormMethod.Post, new { @class = "inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", item.MaBaoCao)
                                            <button type="submit" name="actionType" value="Hide" class="px-3 py-1.5 bg-red-600 text-white text-xs font-bold rounded-md hover:bg-red-700 transition shadow-sm" onclick="return confirm('Bạn có chắc muốn ẩn bài viết này không?')">
                                                Ẩn bài viết
                                            </button>
                                            <button type="submit" name="actionType" value="Dismiss" class="px-3 py-1.5 bg-gray-600 text-white text-xs font-bold rounded-md hover:bg-gray-700 transition shadow-sm">
                                                Bỏ qua
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400 italic">Hệ thống đã xử lý</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-20 bg-gray-50 italic text-gray-400">
                <i class="fas fa-check-circle text-5xl mb-3 block opacity-20"></i>
                Hiện không có báo cáo vi phạm nào cần xử lý.
            </div>
        }
    </div>
    
    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex - 1 })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left h-5 w-5"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative z-10 inline-flex items-center bg-red-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex + 1 })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
    }
</div>
