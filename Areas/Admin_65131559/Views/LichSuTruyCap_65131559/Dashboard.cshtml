@model IEnumerable<ProjectCK_65131559.Models.TaiLieu>
@{
    ViewBag.Title = "Dashboard Thống Kê";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
    var stats = ViewBag.Stats as ProjectCK_65131559.Models.sp_LayThongKeDashboard_Result;
}

<div class="container mx-auto px-4 sm:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Dashboard Thống Kê</h1>
        <p class="text-gray-600 mt-2">Tổng quan hoạt động của hệ thống thư viện số</p>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
        <!-- Total Users -->
        <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-blue-500 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Người dùng</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@(stats != null ? stats.TongNguoiDung : 0)</p>
                </div>
                <div class="bg-blue-50 p-3 rounded-full">
                    <i class="fas fa-users text-blue-600 text-lg"></i>
                </div>
            </div>
        </div>

        <!-- Total Documents -->
        <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-green-500 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Tài liệu số</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@(stats != null ? stats.TongTaiLieu : 0)</p>
                </div>
                <div class="bg-green-50 p-3 rounded-full">
                    <i class="fas fa-book text-green-600 text-lg"></i>
                </div>
            </div>
        </div>

        <!-- New Requests -->
        <a href="@Url.Action("Index", "YeuCau_65131559")" class="bg-white rounded-xl shadow-md p-5 border-l-4 border-red-500 hover:shadow-lg transition-all transform hover:-translate-y-1">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Yêu cầu mới</p>
                    <p class="text-2xl font-bold text-red-600 mt-1">@(stats != null ? stats.YeuCauMoi : 0)</p>
                </div>
                <div class="bg-red-50 p-3 rounded-full">
                    <i class="fas fa-bell text-red-600 text-lg animate-pulse"></i>
                </div>
            </div>
        </a>

        <!-- Total Views -->
        <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-purple-500 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Lượt xem</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@(ViewBag.TongLuotXem ?? 0)</p>
                </div>
                <div class="bg-purple-50 p-3 rounded-full">
                    <i class="fas fa-eye text-purple-600 text-lg"></i>
                </div>
            </div>
        </div>

        <!-- Total Downloads -->
        <div class="bg-white rounded-xl shadow-md p-5 border-l-4 border-orange-500 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider">Lượt tải về</p>
                    <p class="text-2xl font-bold text-gray-800 mt-1">@(ViewBag.TongLuotTai ?? 0)</p>
                </div>
                <div class="bg-orange-50 p-3 rounded-full">
                    <i class="fas fa-download text-orange-600 text-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Trending Documents Section -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <h2 class="text-xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-fire text-red-500 mr-2"></i>
                Tài liệu đang HOT
            </h2>
            <span class="text-sm text-gray-500">Top 5 tài liệu có tương tác cao nhất</span>
        </div>
        
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">#</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tên tài liệu</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Danh mục</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Lượt xem</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Lượt tải</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Tổng tương tác</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model != null && Model.Any())
                    {
                        int rank = 1;
                        foreach (var item in Model)
                        {
                            var totalInteraction = (item.LuotXem ?? 0) + (item.LuotTai ?? 0);
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (rank == 1)
                                    {
                                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-yellow-100 text-yellow-600 font-bold">1</span>
                                    }
                                    else if (rank == 2)
                                    {
                                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-600 font-bold">2</span>
                                    }
                                    else if (rank == 3)
                                    {
                                        <span class="flex items-center justify-center w-8 h-8 rounded-full bg-orange-100 text-orange-600 font-bold">3</span>
                                    }
                                    else
                                    {
                                        <span class="flex items-center justify-center w-8 h-8 font-bold text-gray-500">@rank</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm font-medium text-blue-600 hover:text-blue-800">
                                        @Html.ActionLink(item.TenTaiLieu, "Details", "TaiLieu_65131559", new { id = item.MaTaiLieu }, null)
                                    </div>
                                    <div class="text-xs text-gray-500 mt-1">ISBN: @(item.ISBN ?? "N/A")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <span class="px-2 py-1 bg-gray-100 rounded text-xs">
                                        @(item.DanhMucCon != null ? item.DanhMucCon.TenDanhMucCon : "Chưa phân loại")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-600">
                                    <i class="fas fa-eye mr-1 text-gray-400"></i> @(item.LuotXem ?? 0)
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-600">
                                    <i class="fas fa-download mr-1 text-gray-400"></i> @(item.LuotTai ?? 0)
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-center">
                                    <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm font-bold">
                                        @totalInteraction
                                    </span>
                                </td>
                            </tr>
                            rank++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-500 italic">
                                Chưa có dữ liệu thống kê
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
