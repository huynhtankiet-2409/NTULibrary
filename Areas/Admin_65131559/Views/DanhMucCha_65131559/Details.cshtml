@model ProjectCK_65131559.Models.DanhMucCha

@{
    ViewBag.Title = "Chi tiết Danh mục cha";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-3xl mx-auto mt-6">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="flex items-center justify-between p-6 border-b border-gray-100 bg-indigo-50">
            <h2 class="text-xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-folder text-indigo-600 mr-3"></i>Chi tiết Danh mục cha
            </h2>
            <div class="px-3 py-1 bg-white text-indigo-800 rounded text-sm font-mono border border-indigo-100">
                ID: @Model.MaDanhMucCha
            </div>
        </div>

        <div class="p-8 space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-1">
                     <div class="w-full h-32 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-400">
                         <i class="fas fa-project-diagram text-6xl opacity-50"></i>
                     </div>
                </div>
                <div class="md:col-span-2 space-y-4">
                     <div>
                        <span class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Tên Danh mục</span>
                        <div class="text-2xl font-bold text-gray-900">@Model.TenDanhMucCha</div>
                     </div>
                     <div>
                        <span class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Mô tả</span>
                        <div class="text-gray-700 bg-gray-50 p-3 rounded border border-gray-100 mt-1">
                            @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                        </div>
                     </div>
                </div>
            </div>

            <div class="border-t pt-6">
                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                    <i class="fas fa-list-ul mr-2 text-gray-400"></i>Danh mục con trực thuộc
                </h3>
                
                @if (Model.DanhMucCons != null && Model.DanhMucCons.Any())
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        @foreach (var child in Model.DanhMucCons)
                        {
                            <div class="flex items-center p-3 bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow transition-shadow">
                                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 mr-3 font-bold text-xs">
                                    @child.MaDanhMucCon
                                </div>
                                <span class="font-medium text-gray-700">@child.TenDanhMucCon</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-6 bg-gray-50 rounded-lg border border-dashed border-gray-300 text-gray-500 italic">
                        Chưa có danh mục con nào.
                    </div>
                }
            </div>
        </div>

        <div class="bg-gray-50 px-6 py-4 flex justify-between items-center border-t border-gray-100">
            <a href="@Url.Action("Index")" class="text-gray-600 hover:text-gray-900 font-medium">
                <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
            </a>
            <div class="flex space-x-3">
                <a href="@Url.Action("Edit", new { id = Model.MaDanhMucCha })" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-sm font-medium transition-colors">
                    <i class="fas fa-edit mr-1"></i>Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>
