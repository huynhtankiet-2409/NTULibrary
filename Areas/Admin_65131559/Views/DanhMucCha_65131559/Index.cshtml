@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.DanhMucCha>

@{
    ViewBag.Title = "Quản lý Danh mục cha";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Quản lý Chuyên mục (Danh mục cha)</h2>
            <p class="text-gray-500 text-sm mt-1">Phân loại cấp 1 cho tài liệu</p>
        </div>
        <a href="@Url.Action("Create")" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-5 rounded-lg shadow transition duration-150 ease-in-out flex items-center">
            <i class="fas fa-plus mr-2"></i>Thêm Danh mục
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-shadow duration-200">
                <div class="p-5">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-lg">
                            @item.TenDanhMucCha.Substring(0, 1).ToUpper()
                        </div>
                        <div class="flex space-x-2">
                            <a href="@Url.Action("Edit", new { id = item.MaDanhMucCha })" class="text-gray-400 hover:text-indigo-600 transition-colors">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", new { id = item.MaDanhMucCha })" class="text-gray-400 hover:text-red-600 transition-colors">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">
                        <a href="@Url.Action("Details", new { id = item.MaDanhMucCha })" class="hover:text-indigo-600">@item.TenDanhMucCha</a>
                    </h3>
                    @if (!string.IsNullOrEmpty(item.MoTa))
                    {
                        <p class="text-sm text-gray-500 line-clamp-2 mb-4 h-10">@item.MoTa</p>
                    }
                    else
                    {
                        <p class="text-sm text-gray-400 italic mb-4 h-10">Không có mô tả</p>
                    }
                    
                    <div class="pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
                        <span><i class="fas fa-layer-group mr-1"></i> @(item.DanhMucCons != null ? item.DanhMucCons.Count : 0) danh mục con</span>
                        <span class="font-mono opacity-50">ID: @item.MaDanhMucCha</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12 bg-white rounded-xl border border-dashed border-gray-300">
            <i class="fas fa-folder-open text-4xl text-gray-300 mb-3"></i>
            <p class="text-gray-500">Chưa có danh mục cha nào.</p>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex - 1 })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left h-5 w-5"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex + 1 })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>
