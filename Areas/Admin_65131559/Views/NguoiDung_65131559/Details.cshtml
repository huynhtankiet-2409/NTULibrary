@model ProjectCK_65131559.Models.NguoiDung

@{
    ViewBag.Title = "Chi tiết Người dùng";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto mt-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết Người dùng</h2>
            <p class="text-sm text-gray-600">Thông tin chi tiết về tài khoản và hồ sơ</p>
        </div>
        <a href="@Url.Action("Index")" class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors">
            <i class="fas fa-arrow-left mr-2"></i> Quay lại
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100">
        <!-- Profile Header -->
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-8 text-white">
            <div class="flex flex-col md:flex-row items-center gap-6">
                <div class="relative">
                    @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                    {
                        <img src="@Url.Content(Model.AnhDaiDien)" alt="Profile" class="h-24 w-24 rounded-full border-4 border-white/30 object-cover shadow-lg bg-white">
                    }
                    else
                    {
                        <div class="h-24 w-24 rounded-full border-4 border-white/30 bg-blue-500 flex items-center justify-center text-3xl font-bold shadow-lg text-white">
                            @(!string.IsNullOrEmpty(Model.HoTen) ? Model.HoTen.Substring(0, 1).ToUpper() : "U")
                        </div>
                    }
                    <div class="absolute bottom-0 right-0 w-6 h-6 rounded-full border-2 border-white @(Model.TrangThai == "HoatDong" ? "bg-green-400" : "bg-red-400")" title="@(Model.TrangThai == "HoatDong" ? "Hoạt động" : "Bị khóa")"></div>
                </div>
                <div class="text-center md:text-left">
                    <h3 class="text-2xl font-bold">@Model.HoTen</h3>
                    <p class="text-blue-100 font-mono text-sm mt-1">@Model.MaSoSinhVien</p>
                    <div class="flex items-center justify-center md:justify-start gap-3 mt-3">
                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-white/20 border border-white/30 text-white">
                            @(Model.VaiTro == "Admin" ? "Quản trị viên" : "Sinh viên")
                        </span>
                        <span class="px-3 py-1 rounded-full text-xs font-semibold @(Model.TrangThai == "HoatDong" ? "bg-green-500/20 text-green-100 border border-green-400/30" : "bg-red-500/20 text-red-100 border border-red-400/30")">
                            @(Model.TrangThai == "HoatDong" ? "Đang hoạt động" : "Đã bị khóa")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Details -->
        <div class="p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Account Info -->
                <div class="space-y-6">
                    <h4 class="text-lg font-bold text-gray-800 border-b pb-2 flex items-center">
                        <i class="fas fa-id-card text-blue-600 mr-2"></i> Thông tin tài khoản
                    </h4>
                    
                    <dl class="space-y-4">
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Tên đăng nhập:</dt>
                            <dd class="text-sm font-semibold text-gray-900">@Model.TenDangNhap</dd>
                        </div>
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Email:</dt>
                            <dd class="text-sm text-gray-900">@Model.Email</dd>
                        </div>
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Mật khẩu:</dt>
                            <dd class="text-sm font-mono text-gray-500 bg-gray-100 px-2 py-0.5 rounded">
                                ••••••••
                                <span class="text-xs text-gray-400 ml-2">(Đã mã hóa)</span>
                            </dd>
                        </div>
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Ngày tạo:</dt>
                            <dd class="text-sm text-gray-900">@String.Format("{0:dd/MM/yyyy HH:mm}", Model.NgayTao)</dd>
                        </div>
                    </dl>
                </div>

                <!-- Personal Info -->
                <div class="space-y-6">
                    <h4 class="text-lg font-bold text-gray-800 border-b pb-2 flex items-center">
                        <i class="fas fa-user-tag text-blue-600 mr-2"></i> Thông tin cá nhân
                    </h4>
                    
                    <dl class="space-y-4">
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Khoa / Đơn vị:</dt>
                            <dd class="text-sm text-gray-900">
                                @(!string.IsNullOrEmpty(Model.Khoa) ? Model.Khoa : "---")
                            </dd>
                        </div>
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Số điện thoại:</dt>
                            <dd class="text-sm text-gray-900 font-mono">
                                @(!string.IsNullOrEmpty(Model.SoDienThoai) ? Model.SoDienThoai : "---")
                            </dd>
                        </div>
                        <div class="flex sm:flex-row flex-col">
                            <dt class="text-sm font-medium text-gray-500 w-36 flex-shrink-0">Vai trò:</dt>
                            <dd class="text-sm text-gray-900">
                                @(Model.VaiTro == "Admin" ? "Quản trị viên hệ thống" : "Sinh viên / Người dùng")
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
            
            <!-- Actions -->
            <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-end space-x-3">
                <a href="@Url.Action("Edit", new { id = Model.MaNguoiDung })" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium shadow-sm">
                    <i class="fas fa-edit mr-2"></i> Chỉnh sửa
                </a>
                <button onclick="if(confirm('Bạn có chắc chắn muốn xóa người dùng này?')) location.href='@Url.Action("Delete", new { id = Model.MaNguoiDung })'" class="inline-flex items-center px-4 py-2 bg-white text-red-600 border border-red-200 rounded-lg hover:bg-red-50 transition-colors font-medium">
                    <i class="fas fa-trash-alt mr-2"></i> Xóa
                </button>
            </div>
        </div>
    </div>
</div>
