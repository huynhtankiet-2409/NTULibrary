@model ProjectCK_65131559.Models.NguoiDung

@{
    ViewBag.Title = "Thêm Người Dùng Mới";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-user-plus text-ntu-blue mr-3"></i>
            Thêm Người Dùng Mới
        </h2>
        <p class="text-gray-600 mt-2">Tạo tài khoản mới cho sinh viên hoặc quản trị viên</p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "bg-red-50 border-l-4 border-red-500 p-4 mb-6 text-red-700" })

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Tên đăng nhập -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-user mr-1"></i> Tên đăng nhập <span class="text-red-500">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.TenDangNhap, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "Nhập tên đăng nhập" })
                    @Html.ValidationMessageFor(model => model.TenDangNhap, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Mật khẩu -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-lock mr-1"></i> Mật khẩu <span class="text-red-500">*</span>
                    </label>
                    @Html.PasswordFor(model => model.MatKhau, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "Nhập mật khẩu (tối thiểu 6 ký tự)" })
                    @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Họ tên -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-id-card mr-1"></i> Họ và tên <span class="text-red-500">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.HoTen, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "Nhập họ và tên" })
                    @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- MSSV -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-id-badge mr-1"></i> Mã số sinh viên
                    </label>
                    @Html.TextBoxFor(model => model.MaSoSinhVien, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "Nhập MSSV (nếu là sinh viên)" })
                    @Html.ValidationMessageFor(model => model.MaSoSinhVien, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-envelope mr-1"></i> Email <span class="text-red-500">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Email, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "email@example.com", type = "email" })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Số điện thoại -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-phone mr-1"></i> Số điện thoại
                    </label>
                    @Html.TextBoxFor(model => model.SoDienThoai, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "Nhập số điện thoại" })
                    @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Khoa -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-building mr-1"></i> Khoa
                    </label>
                    @Html.TextBoxFor(model => model.Khoa, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "Nhập khoa" })
                    @Html.ValidationMessageFor(model => model.Khoa, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Vai trò -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-shield-alt mr-1"></i> Vai trò <span class="text-red-500">*</span>
                    </label>
                    @Html.DropDownListFor(model => model.VaiTro,
                        new SelectList(new[] {
                            new { Value = "SinhVien", Text = "Sinh viên" },
                            new { Value = "QuanTri", Text = "Quản trị viên" }
                        }, "Value", "Text"),
                        "-- Chọn vai trò --",
                        new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.VaiTro, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Trạng thái -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-toggle-on mr-1"></i> Trạng thái
                    </label>
                    @Html.DropDownListFor(model => model.TrangThai,
                        new SelectList(new[] {
                            new { Value = "HoatDong", Text = "Hoạt động" },
                            new { Value = "BiKhoa", Text = "Bị khóa" }
                        }, "Value", "Text", "HoatDong"),
                        new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-red-500 text-sm mt-1" })
                    <p class="text-sm text-gray-500 mt-1">Mặc định: Hoạt động</p>
                </div>
            </div>

            <!-- URL Ảnh đại diện (full width) -->
            <div class="mt-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-image mr-1"></i> URL Ảnh đại diện
                </label>
                @Html.TextBoxFor(model => model.AnhDaiDien, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", placeholder = "https://example.com/avatar.jpg" })
                @Html.ValidationMessageFor(model => model.AnhDaiDien, "", new { @class = "text-red-500 text-sm mt-1" })
            </div>

            <!-- Info note -->
            <div class="mt-6 bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
                <p class="text-sm text-blue-700">
                    <i class="fas fa-info-circle mr-2"></i>
                    <strong>Lưu ý:</strong> NgayTao sẽ được tự động thiết lập. Mật khẩu nên có ít nhất 6 ký tự.
                </p>
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-between mt-8 pt-6 border-t">
                <a href="@Url.Action("Index")" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Quay lại
                </a>
                <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md">
                    <i class="fas fa-save mr-2"></i>Tạo tài khoản
                </button>
            </div>
        }
    </div>
</div>

<style>
    .ntu-blue {
        color: #667eea;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
