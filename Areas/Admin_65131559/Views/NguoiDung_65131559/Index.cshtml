@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.NguoiDung>

@{
    ViewBag.Title = "Quản lý Người Dùng";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-6">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-lg shadow-sm">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                <p class="text-green-700 font-medium">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-lg shadow-sm">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle text-red-500 text-xl mr-3"></i>
                <p class="text-red-700 font-medium">@TempData["ErrorMessage"]</p>
            </div>
        </div>
    }

    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <i class="fas fa-users text-ntu-blue mr-3"></i>
                    Quản lý Người Dùng
                </h2>
                <p class="text-gray-600 mt-1">Quản lý tài khoản sinh viên và quản trị viên</p>
            </div>
            <a href="@Url.Action("Create")" class="bg-ntu-blue text-white px-6 py-3 rounded-lg hover:bg-ntu-dark transition-colors duration-200 flex items-center shadow-md">
                <i class="fas fa-user-plus mr-2"></i>
                Thêm người dùng mới
            </a>
        </div>
    </div>

    <!-- User Table -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gradient-to-r from-blue-600 to-indigo-600">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Người dùng</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">MSSV</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Email</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Khoa</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Vai trò</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Trạng thái</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-white uppercase tracking-wider">Ngày tạo</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-white uppercase tracking-wider">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="flex-shrink-0 h-10 w-10">
                                        @if (!string.IsNullOrEmpty(item.AnhDaiDien))
                                        {
                                            <img class="h-10 w-10 rounded-full object-cover" src="@item.AnhDaiDien" alt="Avatar">
                                        }
                                        else
                                        {
                                            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-blue-400 to-indigo-500 flex items-center justify-center">
                                                <span class="text-white font-bold text-lg">@(item.HoTen != null && item.HoTen.Length > 0 ? item.HoTen.Substring(0, 1).ToUpper() : "?")</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-medium text-gray-900">@item.HoTen</div>
                                        <div class="text-sm text-gray-500">@@@item.TenDangNhap</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-900">@(item.MaSoSinhVien ?? "N/A")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-600">@(item.Email ?? "N/A")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm text-gray-600">@(item.Khoa ?? "N/A")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.VaiTro != null && (item.VaiTro.ToLower().Contains("admin") || item.VaiTro.ToLower().Contains("quantri")))
                                {
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">
                                        <i class="fas fa-shield-alt mr-1"></i> Quản trị
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        <i class="fas fa-user mr-1"></i> Sinh viên
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.TrangThai == "HoatDong")
                                {
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        <i class="fas fa-check-circle mr-1"></i> Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                        <i class="fas fa-lock mr-1"></i> Bị khóa
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy") : "N/A")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                <div class="flex justify-center items-center space-x-2">
                                    <!-- Lock/Unlock Button -->
                                    <a href="@Url.Action("ToggleLock", new { id = item.MaNguoiDung })" 
                                       class="@(item.TrangThai == "HoatDong" ? "text-red-600 hover:text-red-800" : "text-green-600 hover:text-green-800") transition-colors" 
                                       title="@(item.TrangThai == "HoatDong" ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                        <i class="fas @(item.TrangThai == "HoatDong" ? "fa-lock" : "fa-unlock") text-lg"></i>
                                    </a>

                                    <!-- Reset Password Button -->
                                    @using (Html.BeginForm("SendPasswordReset", "NguoiDung_65131559", new { id = item.MaNguoiDung }, FormMethod.Post, new { @class = "inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-yellow-600 hover:text-yellow-800 transition-colors" title="Reset mật khẩu">
                                            <i class="fas fa-key text-lg"></i>
                                        </button>
                                    }

                                    <!-- Edit Button -->
                                    <a href="@Url.Action("Edit", new { id = item.MaNguoiDung })" 
                                       class="text-blue-600 hover:text-blue-800 transition-colors" 
                                       title="Chỉnh sửa">
                                        <i class="fas fa-edit text-lg"></i>
                                    </a>

                                    <!-- Details Button -->
                                    <a href="@Url.Action("Details", new { id = item.MaNguoiDung })" 
                                       class="text-indigo-600 hover:text-indigo-800 transition-colors" 
                                       title="Chi tiết">
                                        <i class="fas fa-info-circle text-lg"></i>
                                    </a>

                                    <!-- Delete Button -->
                                    <a href="@Url.Action("Delete", new { id = item.MaNguoiDung })" 
                                       class="text-red-600 hover:text-red-800 transition-colors" 
                                       title="Xóa">
                                        <i class="fas fa-trash text-lg"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-users text-6xl text-gray-300 mb-4"></i>
                <p class="text-gray-500 text-lg">Chưa có người dùng nào trong hệ thống</p>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex - 1 })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left h-5 w-5"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative z-10 inline-flex items-center bg-blue-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex + 1 })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .ntu-blue {
        background-color: #667eea;
    }
    .ntu-dark {
        background-color: #5568d3;
    }
</style>
