@model ProjectCK_65131559.Models.NguoiDung

@{
    ViewBag.Title = "Chỉnh Sửa Người Dùng";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-edit text-ntu-blue mr-3"></i>
            Chỉnh Sửa Thông Tin Người Dùng
        </h2>
        <p class="text-gray-600 mt-2">Cập nhật thông tin cho: <strong>@Model.HoTen</strong></p>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-lg shadow-md p-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "bg-red-50 border-l-4 border-red-500 p-4 mb-6 text-red-700" })
            @Html.HiddenFor(model => model.MaNguoiDung)

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Tên đăng nhập -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-user mr-1"></i> Tên đăng nhập <span class="text-red-500">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.TenDangNhap, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.TenDangNhap, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Họ tên -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-id-card mr-1"></i> Họ và tên <span class="text-red-500">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.HoTen, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- MSSV -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-id-badge mr-1"></i> Mã số sinh viên
                    </label>
                    @Html.TextBoxFor(model => model.MaSoSinhVien, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.MaSoSinhVien, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-envelope mr-1"></i> Email <span class="text-red-500">*</span>
                    </label>
                    @Html.TextBoxFor(model => model.Email, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent", type = "email" })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Số điện thoại -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-phone mr-1"></i> Số điện thoại
                    </label>
                    @Html.TextBoxFor(model => model.SoDienThoai, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.SoDienThoai, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Khoa -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-building mr-1"></i> Khoa
                    </label>
                    @Html.TextBoxFor(model => model.Khoa, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.Khoa, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Vai trò -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-shield-alt mr-1"></i> Vai trò <span class="text-red-500">*</span>
                    </label>
                    @Html.DropDownListFor(model => model.VaiTro,
                        new SelectList(new[] {
                            new { Value = "SinhVien", Text = "Sinh viên" },
                            new { Value = "QuanTri", Text = "Quản trị viên" }
                        }, "Value", "Text", Model.VaiTro),
                        new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.VaiTro, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>

                <!-- Trạng thái -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-toggle-on mr-1"></i> Trạng thái
                    </label>
                    @Html.DropDownListFor(model => model.TrangThai,
                        new SelectList(new[] {
                            new { Value = "HoatDong", Text = "Hoạt động" },
                            new { Value = "BiKhoa", Text = "Bị khóa" }
                        }, "Value", "Text", Model.TrangThai),
                        new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                    @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-red-500 text-sm mt-1" })
                </div>
            </div>

            <!-- Mật khẩu mới (optional) -->
            <div class="mt-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-lock mr-1"></i> Mật khẩu mới (tùy chọn)
                </label>
                <input type="password" name="MatKhauMoi" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Để trống nếu không muốn thay đổi mật khẩu" />
                <p class="text-sm text-gray-500 mt-1">
                    <i class="fas fa-info-circle mr-1"></i>
                    Chỉ nhập nếu bạn muốn thay đổi mật khẩu. Để trống để giữ nguyên mật khẩu hiện tại.
                </p>
            </div>

            <!-- URL Ảnh đại diện -->
            <div class="mt-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-image mr-1"></i> URL Ảnh đại diện
                </label>
                @Html.TextBoxFor(model => model.AnhDaiDien, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" })
                @Html.ValidationMessageFor(model => model.AnhDaiDien, "", new { @class = "text-red-500 text-sm mt-1" })
            </div>

            <!-- Ngày tạo (readonly) -->
            <div class="mt-6">
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    <i class="fas fa-calendar mr-1"></i> Ngày tạo
                </label>
                <input type="text" value="@(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")" class="w-full px-4 py-2 border border-gray-200 rounded-lg bg-gray-50" readonly />
                @Html.HiddenFor(model => model.NgayTao)
            </div>

            <!-- Buttons -->
            <div class="flex items-center justify-between mt-8 pt-6 border-t">
                <a href="@Url.Action("Index")" class="px-6 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Quay lại
                </a>
                <button type="submit" class="px-8 py-3 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-semibold rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-md">
                    <i class="fas fa-save mr-2"></i>Lưu thay đổi
                </button>
            </div>
        }
    </div>
</div>

<style>
    .ntu-blue {
        color: #667eea;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
