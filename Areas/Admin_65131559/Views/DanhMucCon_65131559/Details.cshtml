@model ProjectCK_65131559.Models.DanhMucCon

@{
    ViewBag.Title = "Chi tiết Danh mục con";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-3xl mx-auto mt-6">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <div class="flex items-center justify-between p-6 border-b border-gray-100 bg-teal-50">
            <h2 class="text-xl font-bold text-gray-800 flex items-center">
                <i class="fas fa-sitemap text-teal-600 mr-3"></i>Chi tiết Danh mục con
            </h2>
            <div class="px-3 py-1 bg-white text-teal-800 rounded text-sm font-mono border border-teal-100">
                ID: @Model.MaDanhMucCon
            </div>
        </div>

        <div class="p-8 space-y-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-4">
                     <div>
                        <span class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Tên Danh mục con</span>
                        <div class="text-2xl font-bold text-gray-900">@Model.TenDanhMucCon</div>
                     </div>
                     <div>
                        <span class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Thuộc Danh mục cha</span>
                        <div class="inline-flex items-center px-3 py-1 mt-1 rounded-full bg-indigo-100 text-indigo-800 font-medium">
                            <i class="fas fa-layer-group mr-2 text-xs"></i>
                            @(Model.DanhMucCha != null ? Model.DanhMucCha.TenDanhMucCha : "---")
                        </div>
                     </div>
                </div>
                 <div class="flex items-center justify-center">
                     <div class="w-32 h-32 bg-teal-50 rounded-full flex items-center justify-center text-teal-200">
                         <i class="fas fa-folder text-6xl"></i>
                     </div>
                </div>
            </div>

            <div class="pt-6 border-t border-gray-100">
                <h3 class="text-sm font-bold text-gray-900 mb-4">Tài liệu trong danh mục này:</h3>
                @if (Model.TaiLieux != null && Model.TaiLieux.Any())
                {
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                        <ul class="space-y-2">
                            @foreach (var tl in Model.TaiLieux.Take(5))
                            {
                                <li class="flex items-center text-sm text-gray-700">
                                    <i class="fas fa-file-alt text-gray-400 mr-2"></i>
                                    <span>@tl.TenTaiLieu</span>
                                </li>
                            }
                        </ul>
                         @if (Model.TaiLieux.Count > 5)
                        {
                            <div class="mt-2 text-xs text-gray-500 italic ml-6">... và @(Model.TaiLieux.Count - 5) tài liệu khác.</div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500 italic">Chưa có tài liệu nào.</p>
                }
            </div>
        </div>

        <div class="bg-gray-50 px-6 py-4 flex justify-between items-center border-t border-gray-100">
            <a href="@Url.Action("Index")" class="text-gray-600 hover:text-gray-900 font-medium">
                <i class="fas fa-arrow-left mr-2"></i>Quay lại danh sách
            </a>
            <div class="flex space-x-3">
                <a href="@Url.Action("Edit", new { id = Model.MaDanhMucCon })" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-sm font-medium transition-colors">
                    <i class="fas fa-edit mr-1"></i>Chỉnh sửa
                </a>
            </div>
        </div>
    </div>
</div>
