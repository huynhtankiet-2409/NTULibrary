@model ProjectCK_65131559.Models.DienDan_ChuyenMuc

@{
    ViewBag.Title = "Thêm Chuyên mục mới";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden transition-all hover:shadow-xl">
        <div class="bg-gradient-to-r from-indigo-600 to-indigo-800 px-8 py-6">
            <h2 class="text-2xl font-bold text-white flex items-center">
                <i class="fas fa-folder-plus mr-3"></i>
                Thêm Box Thảo luận mới
            </h2>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="p-8 space-y-6">
                @Html.ValidationSummary(true, "", new { @class = "p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" })

                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">Tên chuyên mục</label>
                    @Html.EditorFor(model => model.TenChuyenMuc, new { htmlAttributes = new { @class = "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none", @placeholder = "Ví dụ: Tin tức thư viện, Góc CNTT..." } })
                    @Html.ValidationMessageFor(model => model.TenChuyenMuc, "", new { @class = "text-xs text-red-500 mt-1" })
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">Mô tả</label>
                    @Html.TextAreaFor(model => model.MoTa, new { @class = "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none", @rows = "4", @placeholder = "Mô tả ngắn gọn về mục đích của Box này..." })
                    @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-xs text-red-500 mt-1" })
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">Thứ tự hiển thị</label>
                    @Html.EditorFor(model => model.ThuTuHienThi, new { htmlAttributes = new { @class = "w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all outline-none", @type = "number" } })
                    @Html.ValidationMessageFor(model => model.ThuTuHienThi, "", new { @class = "text-xs text-red-500 mt-1" })
                </div>

                <div class="flex items-center justify-between pt-6 border-t border-gray-100">
                    <a href="@Url.Action("Index")" class="text-gray-600 hover:text-gray-900 font-medium flex items-center transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Quay lại danh sách
                    </a>
                    <button type="submit" class="bg-indigo-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-indigo-700 transition-all transform hover:-translate-y-0.5 shadow-md active:scale-95">
                        <i class="fas fa-save mr-2"></i>
                        Lưu chuyên mục
                    </button>
                </div>
            </div>
        }
    </div>
</div>
