@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.DienDan_ChuyenMuc>

@{
    ViewBag.Title = "Quản lý Chuyên mục Diễn đàn";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <i class="fas fa-folder-tree text-indigo-600 mr-3"></i>
                    Cấu trúc Diễn đàn
                </h2>
                <p class="text-gray-600 mt-1">Quản lý các Box thảo luận và chuyên mục khoa học</p>
            </div>
            <a href="@Url.Action("Create")" class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition-colors duration-200 flex items-center shadow-md">
                <i class="fas fa-plus mr-2"></i>
                Thêm Box thảo luận
            </a>
        </div>
    </div>

    <!-- Categories List -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider">Thứ tự</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider">Tên chuyên mục</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider">Mô tả</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider">Bài viết</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-wider">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors duration-150">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-500">
                                @item.ThuTuHienThi
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="text-sm font-bold text-gray-900">@item.TenChuyenMuc</span>
                            </td>
                            <td class="px-6 py-4">
                                <p class="text-sm text-gray-600 line-clamp-1">@item.MoTa</p>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="px-3 py-1 bg-indigo-100 text-indigo-800 rounded-full text-xs font-bold">
                                    @(item.DienDan_BaiViet != null ? item.DienDan_BaiViet.Count() : 0)
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-medium">
                                <div class="flex justify-center space-x-3">
                                    <a href="@Url.Action("Edit", new { id = item.MaChuyenMuc })" class="text-blue-600 hover:text-blue-900 transition-colors" title="Chỉnh sửa">
                                        <i class="fas fa-edit text-lg"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.MaChuyenMuc })" class="text-red-600 hover:text-red-900 transition-colors" title="Xóa">
                                        <i class="fas fa-trash text-lg"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="fas fa-folder-open text-6xl text-gray-300 mb-4"></i>
                <p class="text-gray-500 text-lg font-medium">Chưa có chuyên mục nào được tạo.</p>
                <a href="@Url.Action("Create")" class="text-indigo-600 hover:underline mt-2 inline-block">Bắt đầu tạo ngay &rarr;</a>
            </div>
        }
    </div>
    
    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex - 1 })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left h-5 w-5"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex + 1 })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>
