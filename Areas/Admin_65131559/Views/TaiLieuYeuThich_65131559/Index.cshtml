@{
    ViewBag.Title = "Phân tích Mức độ Quan tâm";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
    
    var interestData = ViewBag.InterestAnalytics as List<ProjectCK_65131559.Areas.Admin_65131559.Controllers.TaiLieuYeuThich_65131559Controller.InterestMetric>;
    var deptData = ViewBag.DepartmentInsights as List<ProjectCK_65131559.Areas.Admin_65131559.Controllers.TaiLieuYeuThich_65131559Controller.DepartmentInsight>;
}

<div class="container mx-auto px-4 sm:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">Phân tích Mức độ Quan tâm</h1>
        <p class="text-gray-600 mt-2">Đánh giá nhu cầu sinh viên và xu hướng học tập</p>
    </div>

    <!-- Insights Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
        <!-- Chart Section (User Consumption by Dept) -->
        <div class="lg:col-span-1 bg-white rounded-xl shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2">
                <i class="fas fa-university text-indigo-500 mr-2"></i>
                Quan tâm theo Khoa
            </h3>
            <div class="space-y-4">
                @if (deptData != null && deptData.Any())
                {
                    var maxCount = deptData.Max(x => x.SoLuongQuanTam);
                    foreach (var dept in deptData)
                    {
                        var percent = (double)dept.SoLuongQuanTam / maxCount * 100;
                        <div>
                            <div class="flex justify-between text-sm mb-1">
                                <span class="font-medium text-gray-700">@dept.Khoa</span>
                                <span class="text-gray-500">@dept.SoLuongQuanTam lượt</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2.5">
                                <div class="bg-indigo-600 h-2.5 rounded-full" style="width: @percent%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-gray-500 italic">Chưa có dữ liệu phân tích.</p>
                }
            </div>
            
            <div class="mt-6 p-4 bg-blue-50 rounded-lg text-sm text-blue-800">
                <i class="fas fa-lightbulb mr-2"></i>
                <strong>User Insight:</strong> Dữ liệu này giúp xác định Khoa nào đang sử dụng tài nguyên thư viện nhiều nhất để có kế hoạch bổ sung tài liệu phù hợp.
            </div>
        </div>

        <!-- Top Interest Table -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-md overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
                <h3 class="text-lg font-bold text-gray-800">
                    <i class="fas fa-heart text-red-500 mr-2"></i>
                    Top Tài liệu được Lưu trữ
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tài liệu</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Lượt Lưu (Yêu thích)</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Lượt Tải</th>
                            <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Đánh giá tiềm năng</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @if (interestData != null && interestData.Any())
                        {
                            foreach (var item in interestData)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium text-gray-900">@item.TenTaiLieu</div>
                                        <div class="text-xs text-gray-500">@item.DanhMuc</div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm font-bold text-pink-600">
                                        @item.LuotThich
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center text-sm text-gray-600">
                                        @item.LuotTai
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-center">
                                        @if (item.LuotThich > item.LuotTai * 2 && item.LuotTai < 5)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                                Ca Tiềm Năng (Chưa tải)
                                            </span>
                                        }
                                        else if (item.LuotThich > 10 && item.LuotTai > 10)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                Phổ biến
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                Bình thường
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="px-6 py-8 text-center text-gray-500">Chưa có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="p-4 border-t border-gray-200 bg-gray-50 text-xs text-gray-500">
                * "Ca Tiềm Năng": Tài liệu được lưu nhiều nhưng ít/chưa tải. Có thể do sinh viên lưu để dành hoặc tài liệu quá nặng/khó tải.
            </div>
        </div>
    </div>
</div>
