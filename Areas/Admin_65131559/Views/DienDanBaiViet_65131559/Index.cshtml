@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.DienDan_BaiViet>

@{
    ViewBag.Title = "Kiểm duyệt Bài viết Diễn đàn";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
    string currentStatus = ViewBag.CurrentStatus;
}

<div class="space-y-6">
    <!-- Header & Statistics -->
    <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <h2 class="text-2xl font-bold text-gray-800 flex items-center">
                    <i class="fas fa-comments text-blue-600 mr-3"></i>
                    Kiểm duyệt Bài viết
                </h2>
                <p class="text-gray-600 mt-1">Duyệt, ẩn, khóa hoặc ghim các bài thảo luận từ sinh viên</p>
            </div>
            
            <div class="flex bg-gray-100 p-1 rounded-lg">
                <a href="@Url.Action("Index", new { status = "" })" class="px-4 py-2 rounded-md text-sm font-medium transition-all @(string.IsNullOrEmpty(currentStatus) ? "bg-white shadow-sm text-blue-700" : "text-gray-500 hover:text-gray-700")">
                    Tất cả
                </a>
                <a href="@Url.Action("Index", new { status = "ChoDuyet" })" class="px-4 py-2 rounded-md text-sm font-medium transition-all @(currentStatus == "ChoDuyet" ? "bg-white shadow-sm text-yellow-700" : "text-gray-500 hover:text-gray-700")">
                    Chờ duyệt
                </a>
                <a href="@Url.Action("Index", new { status = "HienThi" })" class="px-4 py-2 rounded-md text-sm font-medium transition-all @(currentStatus == "HienThi" ? "bg-white shadow-sm text-green-700" : "text-gray-500 hover:text-gray-700")">
                    Đang hiển thị
                </a>
                <a href="@Url.Action("Index", new { status = "BiKhoa" })" class="px-4 py-2 rounded-md text-sm font-medium transition-all @(currentStatus == "BiKhoa" ? "bg-white shadow-sm text-red-700" : "text-gray-500 hover:text-gray-700")">
                    Đã khóa
                </a>
            </div>
        </div>
    </div>

    <!-- Articles List -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Tiêu đề / Chuyên mục</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Người đăng / Ngày</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Trạng thái</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Tác vụ Admin</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-start">
                                    @if(item.LaGhim == true) {
                                        <i class="fas fa-thumbtack text-red-500 mt-1 mr-2 rotate-45" title="Đã ghim"></i>
                                    }
                                    <div>
                                        <div class="text-sm font-bold text-gray-900 line-clamp-1">@item.TieuDe</div>
                                        <div class="text-xs text-indigo-600 font-medium">@item.DienDan_ChuyenMuc.TenChuyenMuc</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-gray-900">@item.NguoiDung.HoTen</div>
                                <div class="text-xs text-gray-500">@(item.NgayDang.HasValue ? item.NgayDang.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @switch (item.TrangThai)
                                {
                                    case "ChoDuyet":
                                        <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800 border border-yellow-200">Đợi duyệt</span>
                                        break;
                                    case "HienThi":
                                        <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800 border border-green-200">Hiển thị</span>
                                        break;
                                    case "BiKhoa":
                                        <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 text-red-800 border border-red-200">Đã khóa</span>
                                        break;
                                    case "BiAn":
                                        <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-gray-100 text-gray-800 border border-gray-200">Đã ẩn</span>
                                        break;
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <div class="flex justify-center space-x-2">
                                    @using (Html.BeginForm("UpdateStatus", "DienDanBaiViet_65131559", FormMethod.Post, new { @class = "inline" })) {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.MaBaiViet)
                                        
                                        if (item.TrangThai == "ChoDuyet") {
                                            <button type="submit" name="status" value="HienThi" class="p-1.5 bg-green-50 text-green-600 rounded-md hover:bg-green-600 hover:text-white transition-all shadow-sm" title="Duyệt bài">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                        
                                        if (item.TrangThai == "HienThi") {
                                            <button type="submit" name="status" value="BiKhoa" class="p-1.5 bg-red-50 text-red-600 rounded-md hover:bg-red-600 hover:text-white transition-all shadow-sm" title="Khóa bài">
                                                <i class="fas fa-lock"></i>
                                            </button>
                                        } else if (item.TrangThai == "BiKhoa") {
                                            <button type="submit" name="status" value="HienThi" class="p-1.5 bg-blue-50 text-blue-600 rounded-md hover:bg-blue-600 hover:text-white transition-all shadow-sm" title="Mở khóa">
                                                <i class="fas fa-lock-open"></i>
                                            </button>
                                        }

                                        if (item.TrangThai != "BiAn") {
                                            <button type="submit" name="status" value="BiAn" class="p-1.5 bg-gray-50 text-gray-600 rounded-md hover:bg-gray-600 hover:text-white transition-all shadow-sm" title="Ẩn bài vi phạm">
                                                <i class="fas fa-eye-slash"></i>
                                            </button>
                                        } else {
                                             <button type="submit" name="status" value="HienThi" class="p-1.5 bg-indigo-50 text-indigo-600 rounded-md hover:bg-indigo-600 hover:text-white transition-all shadow-sm" title="Khôi phục hiển thị">
                                                <i class="fas fa-redo"></i>
                                            </button>
                                        }
                                    }

                                    @using (Html.BeginForm("TogglePin", "DienDanBaiViet_65131559", FormMethod.Post, new { @class = "inline" })) {
                                        @Html.AntiForgeryToken()
                                        @Html.Hidden("id", item.MaBaiViet)
                                        <button type="submit" class="p-1.5 @(item.LaGhim == true ? "bg-orange-600 text-white" : "bg-orange-50 text-orange-600") rounded-md hover:bg-orange-600 hover:text-white transition-all shadow-sm" title="@(item.LaGhim == true ? "Bỏ ghim" : "Ghim quan trọng")">
                                            <i class="fas fa-thumbtack"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-20">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-100 mb-4 text-gray-300">
                    <i class="fas fa-inbox text-4xl"></i>
                </div>
                <p class="text-gray-500 text-lg font-medium">Không tìm thấy bài viết nào.</p>
            </div>
        }
    </div>
    
    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        @if (Model.HasPreviousPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex - 1, status = ViewBag.CurrentStatus })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Previous</span>
                                <i class="fas fa-chevron-left h-5 w-5"></i>
                            </a>
                        }

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageIndex)
                            {
                                <span class="relative z-10 inline-flex items-center bg-blue-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", new { page = i, status = ViewBag.CurrentStatus })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                            }
                        }

                        @if (Model.HasNextPage)
                        {
                            <a href="@Url.Action("Index", new { page = Model.PageIndex + 1, status = ViewBag.CurrentStatus })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                <span class="sr-only">Next</span>
                                <i class="fas fa-chevron-right h-5 w-5"></i>
                            </a>
                        }
                    </nav>
                </div>
            </div>
        </div>
    }
</div>
