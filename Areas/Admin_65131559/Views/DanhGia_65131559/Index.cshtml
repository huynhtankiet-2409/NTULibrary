@model ProjectCK_65131559.Models.PaginatedList<ProjectCK_65131559.Models.DanhGia>

@{
    ViewBag.Title = "Quản lý Đánh giá";
    Layout = "~/Areas/Admin_65131559/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mx-auto px-4 sm:px-8">
    <div class="py-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-semibold text-gray-800 flex items-center">
                <i class="fas fa-comments text-blue-600 mr-3"></i>
                Quản lý Đánh giá & Bình luận
            </h2>
        </div>

        <!-- Table Container -->
        <div class="-mx-4 sm:-mx-8 px-4 sm:px-8 py-4 overflow-x-auto">
            <div class="inline-block min-w-full shadow-md rounded-lg overflow-hidden bg-white">
                <table class="min-w-full leading-normal">
                    <thead>
                        <tr class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white">
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-left text-xs font-semibold uppercase tracking-wider">
                                Tài liệu
                            </th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-left text-xs font-semibold uppercase tracking-wider">
                                Người dùng
                            </th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-center text-xs font-semibold uppercase tracking-wider">
                                Điểm sao
                            </th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-left text-xs font-semibold uppercase tracking-wider">
                                Bình luận
                            </th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-center text-xs font-semibold uppercase tracking-wider">
                                Trạng thái
                            </th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-center text-xs font-semibold uppercase tracking-wider">
                                Ngày đăng
                            </th>
                            <th class="px-5 py-3 border-b-2 border-gray-200 text-center text-xs font-semibold uppercase tracking-wider">
                                Thao tác
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors duration-150">
                                <td class="px-5 py-5 text-sm">
                                    <div class="font-medium text-gray-900">@(item.TaiLieu != null ? item.TaiLieu.TenTaiLieu : "N/A")</div>
                                </td>
                                <td class="px-5 py-5 text-sm">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 font-bold text-xs uppercase mr-3">
                                            @(item.NguoiDung != null && item.NguoiDung.TenDangNhap != null && item.NguoiDung.TenDangNhap.Length > 0 ? item.NguoiDung.TenDangNhap.Substring(0, 1) : "?")
                                        </div>
                                        <div class="text-gray-900 font-medium">@(item.NguoiDung != null ? item.NguoiDung.TenDangNhap : "N/A")</div>
                                    </div>
                                </td>
                                <td class="px-5 py-5 text-center text-sm">
                                    <div class="flex justify-center text-yellow-400">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= (item.DiemSao ?? 0))
                                            {
                                                <i class="fas fa-star text-xs"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-gray-300 text-xs"></i>
                                            }
                                        }
                                    </div>
                                    <span class="text-xs text-gray-500 mt-1 block">@(item.DiemSao)/5</span>
                                </td>
                                <td class="px-5 py-5 text-sm">
                                    <p class="text-gray-600 line-clamp-2" title="@item.BinhLuan">@item.BinhLuan</p>
                                </td>
                                <td class="px-5 py-5 text-center text-sm">
                                    @if (item.DuocHienThi == true)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <i class="fas fa-eye mr-1"></i> Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            <i class="fas fa-eye-slash mr-1"></i> Đã ẩn
                                        </span>
                                    }
                                </td>
                                <td class="px-5 py-5 text-center text-sm text-gray-500">
                                    @string.Format("{0:dd/MM/yyyy HH:mm}", item.NgayDang)
                                </td>
                                <td class="px-5 py-5 text-center text-sm">
                                    <div class="flex justify-center items-center space-x-3">
                                        @if (item.DuocHienThi == true)
                                        {
                                            <a href="@Url.Action("ToggleVisibility", new { id = item.MaDanhGia })" 
                                               class="text-green-600 hover:text-green-900 transition-colors p-2 rounded-full hover:bg-green-50" 
                                               title="Đang hiện -> Nhấn để ẩn">
                                                <i class="fas fa-toggle-on text-xl"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("ToggleVisibility", new { id = item.MaDanhGia })" 
                                               class="text-gray-400 hover:text-gray-600 transition-colors p-2 rounded-full hover:bg-gray-50" 
                                               title="Đang ẩn -> Nhấn để hiện">
                                                <i class="fas fa-toggle-off text-xl"></i>
                                            </a>
                                        }

                                        <a href="@Url.Action("Delete", new { id = item.MaDanhGia })" 
                                           class="text-red-500 hover:text-red-700 transition-colors p-2 rounded-full hover:bg-red-50"
                                           title="Xóa bình luận">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                @if (!Model.Any())
                {
                    <div class="text-center py-8 text-gray-500">
                        <i class="fas fa-comments text-4xl mb-3 text-gray-300"></i>
                        <p>Chưa có đánh giá nào.</p>
                    </div>
                }
            </div>
            
            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-4 rounded-lg shadow-sm">
                    <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                        <div>
                            <p class="text-sm text-gray-700">
                                Hiển thị trang <span class="font-medium">@Model.PageIndex</span> / <span class="font-medium">@Model.TotalPages</span>
                            </p>
                        </div>
                        <div>
                            <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                                @if (Model.HasPreviousPage)
                                {
                                    <a href="@Url.Action("Index", new { page = Model.PageIndex - 1 })" class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                        <span class="sr-only">Previous</span>
                                        <i class="fas fa-chevron-left h-5 w-5"></i>
                                    </a>
                                }

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    if (i == Model.PageIndex)
                                    {
                                        <span class="relative z-10 inline-flex items-center bg-blue-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">@i</span>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Index", new { page = i })" class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">@i</a>
                                    }
                                }

                                @if (Model.HasNextPage)
                                {
                                    <a href="@Url.Action("Index", new { page = Model.PageIndex + 1 })" class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                        <span class="sr-only">Next</span>
                                        <i class="fas fa-chevron-right h-5 w-5"></i>
                                    </a>
                                }
                            </nav>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
