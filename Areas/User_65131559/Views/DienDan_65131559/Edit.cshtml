@model ProjectCK_65131559.Models.DienDan_BaiViet
@{
    ViewBag.Title = "Chỉnh sửa bài viết";
    Layout = "~/Areas/User_65131559/Views/Shared/_LayoutUser.cshtml";
}

<div class="container mx-auto max-w-3xl">
    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-100 mt-10">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-700 px-8 py-10">
            <h2 class="text-3xl font-extrabold text-white flex items-center tracking-tight">
                <i class="fas fa-edit mr-4 text-blue-200"></i>
                Chỉnh sửa bài thảo luận
            </h2>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.MaBaiViet)
            
            <div class="p-8 md:p-12 space-y-8">
                @Html.ValidationSummary(true, "", new { @class = "p-4 mb-4 text-xs font-bold text-red-800 rounded-xl bg-red-50" })

                <div class="space-y-3">
                    <label class="block text-sm font-extrabold text-gray-800 uppercase tracking-widest pl-1">Chuyên mục <span class="text-red-500">*</span></label>
                    <div class="relative">
                        @Html.DropDownList("MaChuyenMuc", null, htmlAttributes: new { @class = "w-full appearance-none px-5 py-4 rounded-2xl border border-gray-300 focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none font-medium text-gray-700 bg-white" })
                        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-gray-400">
                            <i class="fas fa-chevron-down text-xs"></i>
                        </div>
                    </div>
                </div>

                <div class="space-y-3">
                    <label class="block text-sm font-extrabold text-gray-800 uppercase tracking-widest pl-1">Tiêu đề bài viết <span class="text-red-500">*</span></label>
                    @Html.EditorFor(model => model.TieuDe, new { htmlAttributes = new { @class = "w-full px-5 py-4 rounded-2xl border border-gray-300 focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none font-bold text-gray-800" } })
                </div>

                <div class="space-y-3">
                    <label class="block text-sm font-extrabold text-gray-800 uppercase tracking-widest pl-1">Nội dung <span class="text-red-500">*</span></label>
                    @Html.TextAreaFor(model => model.NoiDung, new { @class = "w-full px-5 py-5 rounded-3xl border border-gray-300 focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all outline-none font-medium text-gray-700 shadow-inner", @rows = "10" })
                </div>

                <div class="flex items-center justify-between pt-10 border-t border-gray-100">
                    <a href="@Url.Action("BaiViet", new { id = Model.MaBaiViet })" class="text-gray-400 hover:text-gray-800 font-bold flex items-center transition-all bg-gray-50 px-5 py-3 rounded-xl">
                        <i class="fas fa-times-circle mr-3"></i> Hủy
                    </a>
                    <button type="submit" class="bg-blue-600 text-white px-10 py-4 rounded-2xl font-black hover:bg-blue-700 transition-all shadow-xl hover:shadow-blue-600/30 transform hover:-translate-y-1 active:scale-95 flex items-center uppercase tracking-widest">
                        Cập nhật thay đổi <i class="fas fa-save ml-3"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>
