@model IEnumerable<ProjectCK_65131559.Models.DienDan_ChuyenMuc>
@{
    ViewBag.Title = "Diễn đàn thư viện";
    Layout = "~/Areas/User_65131559/Views/Shared/_LayoutUser.cshtml";
    var latestPosts = ViewBag.LatestPosts as List<ProjectCK_65131559.Models.DienDan_BaiViet>;
}

<div class="container mx-auto max-w-6xl">
    <div class="flex flex-col md:flex-row gap-8">
        <!-- Main: Category List -->
        <div class="flex-1 space-y-8">
            <div class="flex justify-between items-center">
                <h2 class="text-3xl font-bold text-gray-900">Diễn đàn</h2>
                <a href="@Url.Action("Create")" class="bg-ntu-blue text-white px-6 py-2.5 rounded-lg font-bold hover:bg-opacity-90 transition-all flex items-center shadow-lg">
                    <i class="fas fa-plus-circle mr-2"></i> Tạo chủ đề mới
                </a>
            </div>

            @foreach (var cat in Model)
            {
                <div class="bg-white rounded-xl shadow-md overflow-hidden border border-gray-100 transition-hover hover:shadow-lg">
                    <div class="bg-gradient-to-r from-ntu-blue to-blue-600 px-6 py-4">
                        <h3 class="text-lg font-bold text-white flex items-center">
                            <i class="fas fa-folder-open mr-3"></i> @cat.TenChuyenMuc
                        </h3>
                    </div>
                    <div class="p-6">
                        <p class="text-gray-600 text-sm mb-4">@cat.MoTa</p>
                        <div class="flex items-center justify-between text-xs font-medium text-gray-500">
                            <span class="flex items-center">
                                <i class="far fa-comments mr-1 text-ntu-blue"></i> @(cat.DienDan_BaiViet != null ? cat.DienDan_BaiViet.Count() : 0) bài viết
                            </span>
                            <a href="@Url.Action("ChuyenMuc", new { id = cat.MaChuyenMuc })" class="text-ntu-blue font-bold hover:underline py-2 px-4 bg-blue-50 rounded-lg">
                                Truy cập chuyên mục &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar: Latest Activity -->
        <div class="w-full md:w-80 space-y-6">
            <div class="bg-white rounded-xl shadow-md p-6 border border-gray-100">
                <h4 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-6 pb-2 border-b border-gray-100">Hoạt động mới nhất</h4>
                <div class="space-y-6">
                    @if (latestPosts != null && latestPosts.Any())
                    {
                        foreach (var post in latestPosts)
                        {
                            <a href="@Url.Action("BaiViet", new { id = post.MaBaiViet })" class="block group">
                                <h5 class="text-sm font-bold text-gray-800 line-clamp-2 group-hover:text-ntu-blue transition-colors mb-1">
                                     @if(post.LaGhim == true) { <i class="fas fa-thumbtack text-red-500 text-[10px] mr-1"></i> }
                                     @post.TieuDe
                                </h5>
                                <div class="flex items-center justify-between text-[10px] text-gray-400">
                                    <span>By @post.NguoiDung.HoTen</span>
                                    <span>@(post.NgayDang.HasValue ? post.NgayDang.Value.ToString("dd/MM") : "")</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-gray-400 italic">Chưa có bài viết nào.</p>
                    }
                </div>
            </div>

            <div class="bg-indigo-600 rounded-xl shadow-lg p-6 text-white overflow-hidden relative group">
                <div class="relative z-10">
                    <h4 class="font-bold mb-2">Quy tắc cộng đồng</h4>
                    <p class="text-xs text-indigo-100 leading-relaxed mb-4">
                        Hãy tôn trọng lẫn nhau và tuân thủ các quy định về học thuật khi thảo luận trên diễn đàn của chúng ta.
                    </p>
                    <button onclick="openRulesModal()" class="inline-block text-[10px] font-bold border border-white/30 px-3 py-1.5 rounded hover:bg-white hover:text-indigo-600 transition-all uppercase tracking-widest">Xem chi tiết</button>
                </div>
                <!-- Abstract deco -->
                <div class="absolute -right-4 -bottom-4 text-white/5 text-8xl rotate-12 group-hover:rotate-45 transition-transform duration-500">
                    <i class="fas fa-shield-alt"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Community Rules Modal -->
<div id="rulesModal" class="fixed inset-0 z-[60] hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="closeRulesModal()"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-2xl sm:w-full animate-in zoom-in duration-300">
            <div class="bg-white">
                <div class="bg-gradient-to-r from-indigo-600 to-blue-700 px-6 py-4 flex justify-between items-center">
                    <h3 class="text-xl font-bold text-white flex items-center" id="modal-title">
                        <i class="fas fa-gavel mr-3"></i> Quy tắc & Quy định Thư viện
                    </h3>
                    <button onclick="closeRulesModal()" class="text-white hover:text-gray-200 transition-colors">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>
                <div class="p-8 space-y-6">
                    <section>
                        <h4 class="text-ntu-blue font-bold flex items-center mb-3">
                            <i class="fas fa-book-reader mr-2"></i> 1. Quy định Đọc Online
                        </h4>
                        <p class="text-sm text-gray-600 leading-relaxed pl-6 border-l-2 border-blue-100">
                            Bạn đọc được đọc online miễn phí tất cả các tài liệu hiện có. Khi mở 1 tài liệu số sẽ có cảnh báo, người dùng <strong>Đồng ý</strong> mới tiếp tục sử dụng được tài liệu.
                        </p>
                    </section>

                    <section>
                        <h4 class="text-ntu-blue font-bold flex items-center mb-3">
                            <i class="fas fa-download mr-2"></i> 2. Chế độ Tải Tài liệu (Hạn ngạch)
                        </h4>
                        <div class="text-sm text-gray-600 leading-relaxed pl-6 border-l-2 border-orange-100 space-y-3">
                            <p>Chế độ tải chỉ áp dụng đối với CBVC, học viên, sinh viên của Trường để phục vụ nghiên cứu và học tập cá nhân. Người dùng phải tuân thủ các quy định của pháp luật.</p>
                            <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                                <ul class="space-y-2">
                                    <li class="flex items-center text-gray-800">
                                        <i class="fas fa-user-tie text-ntu-blue w-5"></i>
                                        <span class="font-bold mr-2">Cán bộ viên chức:</span> tải 30 tài liệu / 30 ngày.
                                    </li>
                                    <li class="flex items-center text-gray-800">
                                        <i class="fas fa-user-graduate text-ntu-blue w-5"></i>
                                        <span class="font-bold mr-2">Học viên, sinh viên:</span> tải 4 tài liệu / 7 ngày.
                                    </li>
                                </ul>
                            </div>
                            <p class="italic text-xs text-red-500 font-medium">
                                <i class="fas fa-exclamation-triangle mr-1"></i> Sau khi hết hạn ngạch, người dùng chỉ có thể xem online và phải đợi sang kỳ tính hạn ngạch kế tiếp mới có thể tiếp tục tải.
                            </p>
                        </div>
                    </section>

                    <section>
                        <h4 class="text-ntu-blue font-bold flex items-center mb-3">
                            <i class="fas fa-users mr-2"></i> 3. Ứng xử Cộng đồng
                        </h4>
                        <p class="text-sm text-gray-600 leading-relaxed pl-6 border-l-2 border-green-100">
                            Hãy tôn trọng lẫn nhau và tuân thủ các quy định về học thuật khi thảo luận trên diễn đàn của chúng ta. Tránh các ngôn từ kích động hoặc nội dung không phù hợp.
                        </p>
                    </section>
                </div>
            </div>
            <div class="bg-gray-50 px-6 py-4 flex justify-end">
                <button onclick="closeRulesModal()" class="bg-ntu-blue text-white px-6 py-2 rounded-lg font-bold hover:bg-ntu-dark transition-all">
                    Tôi đã hiểu
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    function openRulesModal() {
        document.getElementById('rulesModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeRulesModal() {
        document.getElementById('rulesModal').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Close on Escape
    window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeRulesModal();
    });
</script>
}
