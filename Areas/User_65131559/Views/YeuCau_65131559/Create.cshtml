@model ProjectCK_65131559.Models.YeuCau

@{
    ViewBag.Title = "Gửi yêu cầu mới";
    Layout = "~/Areas/User_65131559/Views/Shared/_LayoutUser.cshtml";
}

<div class="max-w-3xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
        <a href="@Url.Action("Index")" class="hover:text-ntu-blue">Yêu cầu & Hỗ trợ</a>
        <i class="fas fa-chevron-right mx-2 text-xs self-center"></i>
        <span class="text-gray-800 font-medium">Gửi yêu cầu mới</span>
    </nav>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
        <div class="bg-gradient-to-r from-ntu-blue to-ntu-light p-6 text-white">
            <h3 class="text-xl font-bold flex items-center">
                <i class="fas fa-paper-plane mr-3"></i> Tạo yêu cầu mới
            </h3>
            <p class="text-blue-100 text-sm mt-1">Đề xuất mua sách, báo lỗi file, hoặc góp ý dịch vụ thư viện.</p>
        </div>

        <div class="p-8">
            @using (Html.BeginForm("Create", "YeuCau_65131559", FormMethod.Post, new { @class = "space-y-6" }))
            {
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Tiêu đề yêu cầu</label>
                    <input type="text" name="TieuDe" required maxlength="200"
                           class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-ntu-blue focus:border-transparent transition-all outline-none"
                           placeholder="Ví dụ: Đề xuất mua giáo trình X, Lỗi file PDF không mở được...">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Nội dung chi tiết</label>
                    <textarea name="NoiDung" rows="8" required
                              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-ntu-blue focus:border-transparent transition-all outline-none resize-none"
                              placeholder="Hãy mô tả chi tiết yêu cầu hoặc vấn đề bạn đang gặp phải..."></textarea>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <a href="@Url.Action("Index")" class="text-gray-500 hover:text-gray-700 font-medium transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i> Quay lại
                    </a>
                    <button type="submit" class="inline-flex items-center px-8 py-3 bg-ntu-blue text-white rounded-xl font-bold hover:bg-ntu-dark transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                        <i class="fas fa-paper-plane mr-2"></i> Gửi yêu cầu ngay
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Tip box -->
    <div class="mt-8 bg-blue-50 rounded-xl p-6 border border-blue-100 flex items-start space-x-4">
        <div class="bg-white p-2 rounded-lg shadow-sm text-ntu-blue">
            <i class="fas fa-lightbulb"></i>
        </div>
        <div>
            <h4 class="font-bold text-blue-900 text-sm mb-1">Mẹo nhỏ</h4>
            <p class="text-xs text-blue-700 leading-relaxed">
                Để yêu cầu của bạn được xử lý nhanh hơn, vui lòng cung cấp đầy đủ thông tin về tên sách, tác giả hoặc link tài liệu nếu có lỗi xảy ra.
            </p>
        </div>
    </div>
</div>
