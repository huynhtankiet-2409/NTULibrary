@model IEnumerable<ProjectCK_65131559.Models.TaiLieuYeuThich>

@{
    ViewBag.Title = "Tủ sách của tôi";
    Layout = "~/Areas/User_65131559/Views/Shared/_LayoutUser.cshtml";
}

<div class="container mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center">
            <i class="fas fa-heart text-red-500 mr-3"></i>
            Tủ sách của tôi
        </h2>
        <span class="bg-blue-100 text-blue-800 text-sm font-semibold px-3 py-1 rounded-full">
            @Model.Count() tài liệu
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var item in Model)
            {
                <div class="bg-white rounded-xl shadow-md border border-gray-100 overflow-hidden hover:shadow-lg transition-shadow duration-300 flex flex-col items-center">
                    <!-- Cover -->
                    <div class="w-full h-48 bg-gray-50 flex items-center justify-center overflow-hidden relative group">
                        @if (!string.IsNullOrEmpty(item.TaiLieu.AnhBia))
                        {
                            <img src="@item.TaiLieu.AnhBia" class="h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="@item.TaiLieu.TenTaiLieu" />
                        }
                        else
                        {
                            <i class="fas fa-book text-4xl text-gray-300"></i>
                        }
                        
                        <!-- Overlay Actions -->
                        <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 gap-3">
                            <a href="@Url.Action("Details", "TraCuu_65131559", new { id = item.MaTaiLieu })" class="bg-white text-gray-800 p-2 rounded-full hover:bg-ntu-blue hover:text-white transition-colors" title="Xem chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@Url.Action("Read", "TraCuu_65131559", new { id = item.MaTaiLieu })" target="_blank" class="bg-white text-gray-800 p-2 rounded-full hover:bg-green-600 hover:text-white transition-colors" title="Đọc ngay">
                                <i class="fas fa-book-reader"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Info -->
                    <div class="p-4 w-full flex flex-col flex-1">
                         <div class="text-xs text-gray-500 mb-1">
                            @(item.TaiLieu.DanhMucCon != null ? item.TaiLieu.DanhMucCon.TenDanhMucCon : "Tài liệu")
                        </div>
                        <h3 class="font-bold text-gray-800 mb-2 line-clamp-2 text-sm flex-1">
                            <a href="@Url.Action("Details", "TraCuu_65131559", new { id = item.MaTaiLieu })" class="hover:text-ntu-blue transition-colors">
                                @item.TaiLieu.TenTaiLieu
                            </a>
                        </h3>
                        
                        <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100">
                             <span class="text-xs text-gray-400" title="Ngày thêm">
                                 <i class="far fa-clock mr-1"></i> @(item.NgayThem.HasValue ? item.NgayThem.Value.ToString("dd/MM/yyyy") : "")
                             </span>
                             
                             @using (Html.BeginForm("Delete", "TuSach_65131559", FormMethod.Post))
                             {
                                 @Html.AntiForgeryToken()
                                 <input type="hidden" name="maTaiLieu" value="@item.MaTaiLieu" />
                                 <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium flex items-center transition-colors" onclick="return confirm('Bạn có chắc muốn bỏ tài liệu này khỏi tủ sách?');">
                                     <i class="fas fa-trash-alt mr-1"></i> Bỏ yêu thích
                                 </button>
                             }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-dashed border-gray-300">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
                <i class="far fa-heart text-3xl"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Tủ sách trống</h3>
            <p class="text-gray-500 mb-6">Bạn chưa lưu tài liệu nào vào danh sách yêu thích.</p>
            <a href="@Url.Action("Index", "TraCuu_65131559")" class="inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-ntu-blue hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                <i class="fas fa-search mr-2"></i> Khám phá tài liệu ngay
            </a>
        </div>
    }
</div>
