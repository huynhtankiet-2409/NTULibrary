@model ProjectCK_65131559.Models.NguoiDung

@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Areas/User_65131559/Views/Shared/_LayoutUser.cshtml";
}

<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <!-- Header / Banner -->
        <div class="bg-gradient-to-r from-ntu-dark to-ntu-blue h-32 relative">
            <div class="absolute -bottom-16 left-8">
                <div class="h-32 w-32 rounded-full border-4 border-white bg-white shadow-lg flex items-center justify-center overflow-hidden" id="avatarPreviewContainer">
                    @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                    {
                        <img src="@Url.Content(Model.AnhDaiDien)" alt="Avatar" class="h-full w-full object-cover" id="avatarImage" />
                    }
                    else
                    {
                        <i class="fas fa-user-circle text-8xl text-gray-300" id="avatarPlaceholder"></i>
                    }
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="pt-20 pb-8 px-8">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">@Model.HoTen</h1>
                    <p class="text-gray-500 font-medium">@Model.VaiTro</p>
                    <p class="text-sm text-gray-400 mt-1">
                        <i class="fas fa-user-tag mr-1"></i> @Model.TenDangNhap
                    </p>
                </div>
                 @if (ViewBag.SuccessMessage != null)
                {
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
                        <span class="block sm:inline">@ViewBag.SuccessMessage</span>
                    </div>
                }
            </div>

            <div class="border-t border-gray-100 pt-6">
                @using (Html.BeginForm("UserProfile", "Account_65131559", FormMethod.Post, new { @class = "space-y-6", enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.MaNguoiDung)
                    @Html.HiddenFor(m => m.TenDangNhap) 
                    @Html.HiddenFor(m => m.MatKhau)
                    @Html.HiddenFor(m => m.VaiTro)

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Anh Dai Dien -->
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Ảnh đại diện</label>
                            <div class="flex items-center space-x-4">
                                <label for="avatarUpload" class="cursor-pointer bg-ntu-blue hover:bg-ntu-dark text-white font-medium py-2 px-4 rounded-lg shadow-md transition-colors duration-200 flex items-center">
                                    <i class="fas fa-upload mr-2"></i> Chọn ảnh từ máy tính
                                </label>
                                <input type="file" id="avatarUpload" name="avatarFile" accept="image/*" class="hidden" />
                                <span id="fileName" class="text-sm text-gray-500">Chưa chọn file</span>
                            </div>
                            <p class="text-xs text-gray-400 mt-1">Chấp nhận: JPG, PNG, GIF. Tối đa 5MB</p>
                        </div>

                        <!-- Ho Ten -->
                        <div>
                            @Html.LabelFor(m => m.HoTen, "Họ và tên", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-ntu-blue focus:border-ntu-blue transition-colors", placeholder = "Nhập họ tên" })
                        </div>

                        <!-- Email -->
                        <div>
                            @Html.LabelFor(m => m.Email, "Email", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-ntu-blue focus:border-ntu-blue transition-colors", type="email", placeholder = "example@ntu.edu.vn" })
                             @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-xs mt-1" })
                        </div>

                         <!-- So Dien Thoai -->
                        <div>
                            @Html.LabelFor(m => m.SoDienThoai, "Số điện thoại", new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-ntu-blue focus:border-ntu-blue transition-colors", placeholder = "Nhập số điện thoại" })
                             @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-red-500 text-xs mt-1" })
                        </div>
                        
                        <!-- Readonly Fields Display -->
                        <div class="md:col-span-2 bg-gray-50 p-4 rounded-lg border border-gray-200">
                             <h3 class="text-sm font-bold text-gray-700 mb-3 uppercase tracking-wide">Thông tin hệ thống</h3>
                             <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                 <div>
                                     <span class="text-xs text-gray-500 block">Tên đăng nhập</span>
                                     <span class="text-sm font-semibold text-gray-800">@Model.TenDangNhap</span>
                                 </div>
                                  <div>
                                     <span class="text-xs text-gray-500 block">Vai trò</span>
                                     <span class="text-sm font-semibold text-ntu-blue bg-blue-50 px-2 py-1 rounded inline-block">@Model.VaiTro</span>
                                 </div>
                                 <div>
                                     <span class="text-xs text-gray-500 block">Trạng thái</span>
                                     <span class="text-sm font-semibold text-green-600">Đang hoạt động</span>
                                 </div>
                             </div>
                        </div>
                    </div>

                    <div class="flex justify-end pt-4">
                        <button type="submit" class="bg-ntu-blue hover:bg-ntu-dark text-white font-bold py-2 px-6 rounded-lg shadow-md transition-colors duration-200 flex items-center">
                            <i class="fas fa-save mr-2"></i> Lưu thay đổi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // Preview avatar before upload
    document.getElementById('avatarUpload').addEventListener('change', function(e) {
        const file = e.target.files[0];
        const fileNameSpan = document.getElementById('fileName');
        const avatarContainer = document.getElementById('avatarPreviewContainer');
        
        if (file) {
            // Validate file size (5MB max)
            if (file.size > 5 * 1024 * 1024) {
                alert('Kích thước file quá lớn. Vui lòng chọn file nhỏ hơn 5MB.');
                e.target.value = '';
                fileNameSpan.textContent = 'Chưa chọn file';
                return;
            }
            
            // Validate file type
            if (!file.type.match('image.*')) {
                alert('Vui lòng chọn file ảnh (JPG, PNG, GIF).');
                e.target.value = '';
                fileNameSpan.textContent = 'Chưa chọn file';
                return;
            }
            
            fileNameSpan.textContent = file.name;
            
            // Preview image
            const reader = new FileReader();
            reader.onload = function(e) {
                // Remove existing content
                avatarContainer.innerHTML = '';
                
                // Create and add new image
                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = 'Avatar Preview';
                img.className = 'h-full w-full object-cover';
                img.id = 'avatarImage';
                avatarContainer.appendChild(img);
            };
            reader.readAsDataURL(file);
        } else {
            fileNameSpan.textContent = 'Chưa chọn file';
        }
    });
</script>
