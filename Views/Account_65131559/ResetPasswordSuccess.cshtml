@{
    ViewBag.Title = "Đổi Mật Khẩu Thành Công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gradient-to-br from-green-50 to-emerald-100 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="bg-white rounded-xl shadow-2xl p-8 text-center">
            <!-- Success Icon with Animation -->
            <div class="mx-auto h-20 w-20 bg-green-100 rounded-full flex items-center justify-center mb-6 animate-bounce-once">
                <i class="fas fa-check-circle text-green-600 text-4xl"></i>
            </div>

            <!-- Title -->
            <h2 class="text-2xl font-bold text-gray-900 mb-4">
                Đổi Mật Khẩu Thành Công!
            </h2>

            <!-- Success Message -->
            <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-6 text-left rounded">
                <p class="text-green-700">
                    <i class="fas fa-check-circle mr-2"></i>
                    @ViewBag.SuccessMessage
                </p>
            </div>

            <!-- User Info -->
            @if (!string.IsNullOrEmpty(ViewBag.HoTen))
            {
                <div class="mb-6">
                    <p class="text-gray-600 text-sm">Tài khoản:</p>
                    <p class="text-lg font-semibold text-gray-900 mt-1">@ViewBag.HoTen</p>
                </div>
            }

            <!-- Next Steps -->
            <div class="text-left bg-blue-50 rounded-lg p-4 mb-6">
                <p class="font-semibold text-blue-800 mb-2 flex items-center">
                    <i class="fas fa-info-circle mr-2"></i>
                    Bước tiếp theo:
                </p>
                <ul class="text-sm text-blue-700 space-y-1 ml-5 list-disc">
                    <li>Sử dụng mật khẩu mới để đăng nhập</li>
                    <li>Ghi nhớ mật khẩu hoặc lưu vào trình quản lý mật khẩu</li>
                    <li>Không chia sẻ mật khẩu với người khác</li>
                </ul>
            </div>

            <!-- Login Button -->
            <a href="@Url.Action("Login", "Account_65131559")" 
               class="block w-full px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-lg hover:from-blue-700 hover:to-indigo-700 transition-all shadow-lg text-lg">
                <i class="fas fa-sign-in-alt mr-2"></i>
                Đăng nhập ngay
            </a>

            <!-- Security Tip -->
            <div class="mt-6 pt-6 border-t">
                <p class="text-xs text-gray-500 flex items-center justify-center">
                    <i class="fas fa-shield-alt mr-1"></i>
                    Thư Viện Đại Học Nha Trang - Bảo mật thông tin
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes bounce-once {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
    
    .animate-bounce-once {
        animation: bounce-once 1s ease-in-out;
    }
</style>
