@model ProjectCK_65131559.Models.Forms.ForgotPassword

@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <!-- Card Container -->
        <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
            <!-- Header -->
            <div class="bg-gradient-to-r from-ntu-dark to-ntu-light p-8 text-center">
                <div class="bg-white rounded-full w-20 h-20 flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-key text-ntu-blue text-5xl"></i>
                </div>
                <h2 class="text-3xl font-bold text-white">Quên mật khẩu</h2>
                <p class="text-blue-100 mt-2">Nhập email để khôi phục tài khoản</p>
            </div>

            <!-- Form Body -->
            <div class="p-8">
                @if (ViewBag.Success == true)
                {
                    <!-- Success Message -->
                    <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded-lg mb-6">
                        <div class="flex items-start">
                            <i class="fas fa-check-circle text-green-500 text-xl mr-3 mt-0.5"></i>
                            <div>
                                <p class="text-sm font-medium text-green-800">@ViewBag.Message</p>
                                <p class="text-sm text-green-700 mt-2">Vui lòng kiểm tra hộp thư của bạn.</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Back to Login -->
                    <div class="text-center">
                        @Html.ActionLink("← Quay lại đăng nhập", "Login", "Account_65131559", null, new { @class = "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-gradient-to-r from-ntu-blue to-ntu-light hover:from-ntu-dark hover:to-ntu-blue transition-all duration-200 shadow-lg hover:shadow-xl" })
                    </div>
                }
                else
                {
                    using (Html.BeginForm("ForgotPassword", "Account_65131559", FormMethod.Post, new { @class = "space-y-6", role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Validation Summary -->
                        if (!ViewData.ModelState.IsValid)
                        {
                            <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
                                <div class="flex items-center">
                                    <i class="fas fa-exclamation-circle text-red-500 mr-2"></i>
                                    <div class="text-sm text-red-700">
                                        @Html.ValidationSummary(false, "", new { @class = "font-medium" })
                                    </div>
                                </div>
                            </div>
                        }


                        <!-- Info Message -->
                        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded-lg">
                            <div class="flex items-start">
                                <i class="fas fa-info-circle text-blue-500 mr-2 mt-0.5"></i>
                                <p class="text-sm text-blue-700">
                                    Nhập địa chỉ email đã đăng ký. Chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu đến email của bạn.
                                </p>
                            </div>
                        </div>

                        <!-- Email Field -->
                        <div>
                            @Html.LabelFor(m => m.Email, new { @class = "block text-sm font-semibold text-gray-700 mb-2" })
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-envelope text-gray-400"></i>
                                </div>
                                @Html.TextBoxFor(m => m.Email, new { 
                                    @class = "pl-10 w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-ntu-blue focus:border-transparent transition-all duration-200",
                                    placeholder = "example@ntu.edu.vn",
                                    autocomplete = "email",
                                    type = "email"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-sm mt-1" })
                        </div>

                        <!-- Submit Button -->
                        <div>
                            <button type="submit" class="w-full flex justify-center items-center px-6 py-3 border border-transparent text-base font-medium rounded-lg text-white bg-gradient-to-r from-ntu-blue to-ntu-light hover:from-ntu-dark hover:to-ntu-blue focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ntu-blue transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                                <i class="fas fa-paper-plane mr-2"></i>
                                Gửi yêu cầu
                            </button>
                        </div>

                        <!-- Back to Login Link -->
                        <div class="text-center">
                            @Html.ActionLink("← Quay lại đăng nhập", "Login", "Account_65131559", null, new { @class = "text-sm text-gray-600 hover:text-ntu-blue transition-colors duration-200" })
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Back to Home -->
        <div class="mt-6 text-center">
            @Html.ActionLink("← Quay lại trang chủ", "Index", "Home_65131559", null, new { @class = "text-sm text-gray-600 hover:text-ntu-blue transition-colors duration-200" })
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
