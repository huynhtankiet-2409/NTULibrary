@model ProjectCK_65131559.Models.Forms.ChangePassword

@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Areas/User_65131559/Views/Shared/_LayoutUser.cshtml";
}

<div class="max-w-4xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
        <!-- Header / Banner -->
        <div class="bg-gradient-to-r from-ntu-dark to-ntu-blue h-32 relative">
            <div class="absolute -bottom-16 left-8">
                <div class="h-32 w-32 rounded-full border-4 border-white bg-white shadow-lg flex items-center justify-center overflow-hidden">
                    <i class="fas fa-key text-6xl text-gray-300"></i>
                </div>
            </div>
        </div>

        <!-- Body -->
        <div class="pt-20 pb-8 px-8">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Đổi mật khẩu</h1>
                    <p class="text-gray-500 font-medium">Bảo mật tài khoản của bạn</p>
                </div>
                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
                        <span class="block sm:inline">@ViewBag.SuccessMessage</span>
                    </div>
                }
            </div>

            <div class="border-t border-gray-100 pt-6">
                @using (Html.BeginForm("ChangePassword", "Account_65131559", FormMethod.Post, new { @class = "space-y-6 max-w-lg" }))
                {
                    @Html.AntiForgeryToken()
                    
                    if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                    {
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm">
                             @Html.ValidationSummary(false, "", new { @class = "list-disc pl-5" })
                        </div>
                    }

                    <!-- Old Password -->
                    <div>
                        @Html.LabelFor(m => m.OldPassword, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-ntu-blue focus:border-ntu-blue transition-colors", placeholder = "Nhập mật khẩu hiện tại" })
                        @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <!-- New Password -->
                    <div>
                        @Html.LabelFor(m => m.NewPassword, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-ntu-blue focus:border-ntu-blue transition-colors", placeholder = "Nhập mật khẩu mới (tối thiểu 6 ký tự)" })
                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "block text-sm font-medium text-gray-700 mb-1" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-ntu-blue focus:border-ntu-blue transition-colors", placeholder = "Nhập lại mật khẩu mới" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-red-500 text-xs mt-1" })
                    </div>

                    <div class="flex pt-4">
                        <button type="submit" class="bg-ntu-blue hover:bg-ntu-dark text-white font-bold py-2 px-6 rounded-lg shadow-md transition-colors duration-200 flex items-center">
                            <i class="fas fa-save mr-2"></i> Lưu mật khẩu mới
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
